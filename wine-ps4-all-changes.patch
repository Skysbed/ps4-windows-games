+/* WINE_PS5_WAIT_WATCHDOG: every two seconds, report what each thread waits
+ * on in the server and its message queue's state. A few lines every two
+ * seconds, so it barely changes the timing it is there to explain. */
+extern void dump_queue_state( struct msg_queue *queue );
+extern void dump_process_asyncs( struct process *process );
+
+/* Copy bytes of this process's memory if they can be read: write() reports
+ * EFAULT for an unreadable source instead of faulting. */
+static int ps5_peek( int probe[2], unsigned int address, void *out, size_t size )
+{
+    if (write( probe[1], (const void *)(ULONG_PTR)address, size ) != (ssize_t)size) return 0;
+    return read( probe[0], out, size ) == (ssize_t)size;
+}
+
+static void wait_watchdog( void *arg )
+{
+    struct thread *thread;
+    struct thread_wait *wait;
+    int i;
+
+    fprintf( stderr, "wine-ps5: wait snapshot\n" );
+    LIST_FOR_EACH_ENTRY( thread, &thread_list, struct thread, entry )
+    {
+        fprintf( stderr, "wine-ps5: thread tid=%04x suspend=%d/%d state=%d waiting=%d last_req=%d age_ms=%lld\n",
+                 thread->id, thread->suspend, thread->process->suspend, thread->state, thread->wait != NULL,
+                 thread->ps5_last_req, (long long)((monotonic_time - thread->ps5_last_req_time) / 10000) );
+        /* Silent outside any wait for over a second: where its i386 code is,
+         * from the WoW64 CPU area (TEB64 TlsSlots[WOW64_TLS_CPURESERVED]).
+         * The server runs in the game's process, so it can read it. */
+        if (!thread->wait && thread->teb && monotonic_time - thread->ps5_last_req_time > TICKS_PER_SEC)
+        {
+            const unsigned char *cpu = *(unsigned char * const *)(ULONG_PTR)(thread->teb + 0x1480 + 8);
+            if (cpu && *(const unsigned short *)(cpu + 2) == 0x14c /* IMAGE_FILE_MACHINE_I386 */)
+            {
+                const unsigned char *context = cpu + 4;
+                unsigned int eip = *(const unsigned int *)(context + 0xb8), esp = *(const unsigned int *)(context + 0xc4);
+                fprintf( stderr, "wine-ps5: guest tid=%04x eip=%08x esp=%08x:", thread->id, eip, esp );
+                if (esp) for (i = 0; i < 32; i++) fprintf( stderr, " %08x", ((const unsigned int *)(ULONG_PTR)esp)[i] );
+                fprintf( stderr, "\n" );
+                /* Critical sections among the stack's pointers: a pointer whose
+                 * DebugInfo points back at it. Memory is read only after write()
+                 * to a pipe accepts it, so a bad pointer is skipped, not a crash. */
+                if (esp)
+                {
+                    static int probe[2] = { -1, -1 };
+                    unsigned int seen[16], nseen = 0, k;
+                    if (probe[0] == -1 && pipe( probe )) probe[0] = probe[1] = -1;
+                    for (i = 0; i < 128 && probe[1] != -1; i++)
+                    {
+                        unsigned int word, cs[6], debug[8], dup = 0;
+                        char name[48];
+                        if (!ps5_peek( probe, esp + 4 * i, &word, sizeof(word) )) break;
+                        if (word < 0x10000 || word >= 0x7fff0000 || (word & 3)) continue;
+                        for (k = 0; k < nseen; k++) dup |= seen[k] == word;
+                        if (dup) continue;
+                        if (!ps5_peek( probe, word, cs, sizeof(cs) )) continue;
+                        if (cs[0] < 0x10000 || cs[0] >= 0x7fff0000 || cs[0] == 0xffffffff) continue;
+                        if (!ps5_peek( probe, cs[0], debug, sizeof(debug) ) || debug[1] != word) continue;
+                        if (nseen < 16) seen[nseen++] = word;
+                        name[0] = 0;
+                        /* Wine keeps the section's name in DebugInfo->Spare[0], dword 6 in i386 */
+                        if (debug[6] && ps5_peek( probe, debug[6], name, sizeof(name) - 1 )) name[sizeof(name) - 1] = 0;
+                        else name[0] = 0;
+                        fprintf( stderr, "wine-ps5: guest tid=%04x cs=%08x name=%.40s lock=%d recursion=%d owner=%04x sem=%08x\n",
+                                 thread->id, word, name[0] ? name : "-", (int)cs[1], (int)cs[2], cs[3], cs[4] );
+                    }
+                }
+            }
+        }
+    }
+    {
+        struct process *last = NULL;
+        LIST_FOR_EACH_ENTRY( thread, &thread_list, struct thread, entry )
+            if (thread->process != last) dump_process_asyncs( last = thread->process );
+    }
+    LIST_FOR_EACH_ENTRY( thread, &thread_list, struct thread, entry )
+    {
+        if (thread->queue)
+        {
+            fprintf( stderr, "wine-ps5: queue tid=%04x ", thread->id );
+            dump_queue_state( thread->queue );
+        }
+        for (wait = thread->wait; wait; wait = wait->next)
+        {
+            fprintf( stderr, "wine-ps5: wait tid=%04x pid=%04x ms=%lld op=%d flags=%#x count=%d when=%lld\n",
+                     thread->id, thread->process->id, (long long)((monotonic_time - wait->start) / 10000),
+                     wait->select, wait->flags, wait->count, (long long)wait->when );
+            for (i = 0; i < wait->count; i++)
+            {
+                fprintf( stderr, "wine-ps5:   [%d] ", i );
+                wait->queues[i].obj->ops->dump( wait->queues[i].obj, 0 );
+            }
+        }
+    }
+    add_timeout_user( -2 * TICKS_PER_SEC, wait_watchdog, NULL );
+}
+
+static void start_wait_watchdog(void)
+{
+    static int started;
+
+    if (started) return;
+    started = 1;
+    if (getenv( "WINE_PS5_WAIT_WATCHDOG" )) add_timeout_user( -2 * TICKS_PER_SEC, wait_watchdog, NULL );
+}
