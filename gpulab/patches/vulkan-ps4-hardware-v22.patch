+/* ===================================================================== */
+/* Driver-side present blit.                                              */
+/*                                                                        */
+/* DXVK's own present blitter draws into the swapchain but its            */
+/* psbc-compiled shaders produce no visible pixels (confirmed on          */
+/* hardware: valid source T#, correct viewport/verts, but black; a        */
+/* driver GPU draw into the same swapchain shows up fine). So the driver  */
+/* does the fullscreen textured blit itself, reusing the self-test's      */
+/* proven texture pipeline (blit_shaders.h), sampling DXVK's backbuffer   */
+/* (bound as the blit pass's descriptor-set 0) into the swapchain.        */
+/* ===================================================================== */
+#include "../shaders/blit_shaders.h"
+
+extern VkResult vk_ps4_compile_shader_module(VkPs4ShaderModule *, VkShaderStageFlagBits,
+    const VkAllocationCallbacks *, void **, size_t *, GnmShaderMetadata *,
+    const VkPs4PipelineLayout *, const VkSpecializationInfo *);
+
+static void *blit_gpu_code(const VkAllocationCallbacks *alloc, const GnmShaderMetadata *md) {
+    if (!md || !md->shadercode || md->shadercodesize == 0) return (void *)md->shadercode;
+    void *dst = vk_ps4_alloc(alloc, md->shadercodesize, 256);
+    if (!dst) return (void *)md->shadercode;
+    memcpy(dst, md->shadercode, md->shadercodesize);
+    return dst;
+}
+
+static void vk_ps4_present_blit_init(VkPs4Device *dev) {
+    if (dev->blit_tried) return;
+    dev->blit_tried = true;
+    dev->blit_ps_settable_reg = 0xff;
+    const VkAllocationCallbacks *alloc = &dev->allocator;
+
+    /* Compile with a 1 combined-image-sampler layout (set 0, binding 0) so psbc
+     * emits a PTR_INDIRECTRESOURCETABLE slot + bakes the arena address-hi, exactly
+     * like DXVK's own pipelines. We then point that set table at DXVK's already-
+     * populated descriptor memory (the backbuffer T#+S#). */
+    VkDescriptorSetLayoutBinding b0; memset(&b0, 0, sizeof(b0));
+    b0.binding = 0;
+    b0.descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+    b0.descriptorCount = 1;
+    b0.stageFlags = VK_SHADER_STAGE_FRAGMENT_BIT;
+    VkPs4DescriptorSetLayout dsl; memset(&dsl, 0, sizeof(dsl));
+    dsl.device = dev; dsl.bindings = &b0; dsl.binding_count = 1;
+    dsl.variable_descriptor_binding = UINT32_MAX;
+    VkPs4DescriptorSetLayout *dslp = &dsl;
+    VkPs4PipelineLayout pl; memset(&pl, 0, sizeof(pl));
+    pl.device = dev; pl.set_layouts = &dslp; pl.set_layout_count = 1;
+
+    VkPs4ShaderModule vmod; memset(&vmod, 0, sizeof(vmod));
+    vmod.type = VK_PS4_OBJ_SHADER_MODULE; vmod.device = dev;
+    vmod.binary = (void *)blit_vs_spirv; vmod.binary_size = sizeof(blit_vs_spirv);
+    void *vbin = NULL; size_t vsz = 0; GnmShaderMetadata vmd; memset(&vmd, 0, sizeof(vmd));
+    if (vk_ps4_compile_shader_module(&vmod, VK_SHADER_STAGE_VERTEX_BIT, alloc,
+            &vbin, &vsz, &vmd, &pl, NULL) != VK_SUCCESS) return;
+    if (!(vmd.fileheader && vmd.stage)) return;
+    const GnmVsShader *vs = (const GnmVsShader *)vmd.stage;
+    dev->blit_vs_regs = vs->registers;
+    if (vmd.shadercode) sceGnmVsRegsSetAddress(&dev->blit_vs_regs, blit_gpu_code(alloc, &vmd));
+    { uint32_t n = vs->numexportsemantics;
+      const GnmVertexExportSemantic *e = sceGnmVsShaderExportSemanticTable(vs);
+      if (n > 32) n = 32;
+      if (e && n) { memcpy(dev->blit_vs_exports, e, n * sizeof(*e)); dev->blit_vs_export_count = n; } }
+    dev->blit_vs_binary = vbin;
+
+    VkPs4ShaderModule pmod; memset(&pmod, 0, sizeof(pmod));
+    pmod.type = VK_PS4_OBJ_SHADER_MODULE; pmod.device = dev;
+    pmod.binary = (void *)blit_fs_spirv; pmod.binary_size = sizeof(blit_fs_spirv);
+    void *pbin = NULL; size_t psz = 0; GnmShaderMetadata pmd; memset(&pmd, 0, sizeof(pmd));
+    if (vk_ps4_compile_shader_module(&pmod, VK_SHADER_STAGE_FRAGMENT_BIT, alloc,
+            &pbin, &psz, &pmd, &pl, NULL) != VK_SUCCESS) return;
+    if (!(pmd.fileheader && pmd.stage)) return;
+    const GnmPsShader *ps = (const GnmPsShader *)pmd.stage;
+    dev->blit_ps_regs = ps->registers;
+    if (pmd.shadercode) sceGnmPsRegsSetAddress(&dev->blit_ps_regs, blit_gpu_code(alloc, &pmd));
+    { uint32_t n = ps->numinputsemantics;
+      const GnmPixelInputSemantic *i = sceGnmPsShaderInputSemanticTable(ps);
+      if (n > 32) n = 32;
+      if (i && n) { memcpy(dev->blit_ps_inputs, i, n * sizeof(*i)); dev->blit_ps_input_count = n; } }
