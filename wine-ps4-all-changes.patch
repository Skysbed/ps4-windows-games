+/* getaddrinfo reads the fully qualified computer name from the registry
+ * whenever a lookup fails (GTA IV fails four a frame on a console). The name
+ * is kept between calls only while a registry notification on HKLM\System,
+ * below which GetComputerNameExW reads it, reports no change there. The
+ * watch is armed before the name is read, so any change after a read makes
+ * the next call read the registry again: every call still returns what a
+ * fresh read would. */
+DECLARE_CRITICAL_SECTION(fqdn_cs);
+static HKEY fqdn_key;         /* HKLM\System, opened for the watch */
+static HANDLE fqdn_changed;   /* auto-reset; the registry sets it */
+static BOOL fqdn_watched;     /* the watch is armed and has not fired */
+static WCHAR *fqdn_cache;     /* read after the watch was armed */
+
+/* A fresh wide fully qualified name, or NULL. */
+static WCHAR *read_fqdn(void)
+{
+    WCHAR local[256], *wide;
+    DWORD size = ARRAY_SIZE(local);
+    SIZE_T bytes;
+
+    if (GetComputerNameExW( ComputerNamePhysicalDnsFullyQualified, local, &size ))
+    {
+        if (!(wide = malloc( (size + 1) * sizeof(*wide) ))) return NULL;
+        memcpy( wide, local, (size + 1) * sizeof(*wide) );
+        return wide;
+    }
+    /* Retry once with the API's required capacity for unusually long names. */
+    bytes = (SIZE_T)size * sizeof(*wide);
+    if (GetLastError() != ERROR_MORE_DATA || size <= ARRAY_SIZE(local) ||
+        bytes / sizeof(*wide) != size) return NULL;
+    if (!(wide = malloc( bytes ))) return NULL;
+    if (GetComputerNameExW( ComputerNamePhysicalDnsFullyQualified, wide, &size )) return wide;
+    free( wide );
+    return NULL;
+}
+
+/* Arm the watch; FALSE when the name must not be kept. */
+static BOOL watch_fqdn(void)
+{
+    if (!fqdn_changed && !(fqdn_changed = CreateEventW( NULL, FALSE, FALSE, NULL ))) return FALSE;
+    if (!fqdn_key && RegOpenKeyExW( HKEY_LOCAL_MACHINE, L"System", 0, KEY_NOTIFY, &fqdn_key ))
+    {
+        fqdn_key = NULL;
+        return FALSE;
+    }
+    return !RegNotifyChangeKeyValue( fqdn_key, TRUE, REG_NOTIFY_CHANGE_NAME | REG_NOTIFY_CHANGE_LAST_SET,
+                                     fqdn_changed, TRUE );
+}
+
 static char *get_fqdn(void)
 {
-    char *ret;
-    DWORD size = 0;
+    WCHAR *wide;
+    char *ret = NULL;
+    int count;
 
-    GetComputerNameExA( ComputerNamePhysicalDnsFullyQualified, NULL, &size );
-    if (GetLastError() != ERROR_MORE_DATA) return NULL;
-    if (!(ret = malloc( size ))) return NULL;
-    if (!GetComputerNameExA( ComputerNamePhysicalDnsFullyQualified, ret, &size ))
+    EnterCriticalSection( &fqdn_cs );
+    if (fqdn_watched && WaitForSingleObject( fqdn_changed, 0 ) != WAIT_TIMEOUT)
+    {
+        fqdn_watched = FALSE;
+        free( fqdn_cache );
+        fqdn_cache = NULL;
+    }
+    if (!(wide = fqdn_cache))
+    {
+        if (!fqdn_watched) fqdn_watched = watch_fqdn();
+        wide = read_fqdn();
+        if (fqdn_watched) fqdn_cache = wide;
+    }
+    if (wide && (count = WideCharToMultiByte( CP_ACP, 0, wide, -1, NULL, 0, NULL, NULL )) &&
+        (ret = malloc( count )) && !WideCharToMultiByte( CP_ACP, 0, wide, -1, ret, count, NULL, NULL ))
     {
         free( ret );
-        return NULL;
+        ret = NULL;
     }
+    if (wide != fqdn_cache) free( wide );
+    LeaveCriticalSection( &fqdn_cs );
     return ret;
 }
 
+/* ws2_32 is being unloaded: drop the name and the watch. */
+void free_fqdn_cache(void)
+{
+    free( fqdn_cache );
+    fqdn_cache = NULL;
+    fqdn_watched = FALSE;
+    /* NtClose, like RegCloseKey, without calling into advapi32 here */
+    if (fqdn_key) CloseHandle( fqdn_key );
+    if (fqdn_changed) CloseHandle( fqdn_changed );
+    fqdn_key = NULL;
+    fqdn_changed = NULL;
+}
