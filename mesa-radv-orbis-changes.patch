+                orbis_split.parts + 1, part_bytes[0] / 4, (unsigned)err);
+      orbis_split.failed = true;
+      return NULL;
+   }
+   const uint64_t deadline = os_time_get_nano() + 2000000000ull;
+   while (*orbis_part_word != value) {
