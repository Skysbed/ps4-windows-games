 /* === Allocator helpers === */
+/* === PcPs4 hardware patch: GPU-visible allocator ==========================
+ *
+ * On a real PS4 the GPU can only read memory mapped for GPU use. Command
+ * buffers, compiled shader code and fetch shaders were allocated from the
+ * ordinary heap. Serve every default (no user callback) driver allocation from
+ * one GPU-mapped arena: power-of-two size classes, per-class free lists, bump
+ * carving. */
+#if defined(__ORBIS__) || defined(__PS4__)
+#define PCPS4_ARENA_SIZE (160u * 1024u * 1024u)
+#define PCPS4_ARENA_HDR 32u
+#define PCPS4_ARENA_MAGIC 0x50433441524E4131ull
+typedef struct {
+    uint64_t magic;
+    uint32_t cls;
+    uint32_t pad;
+    void *raw;
+    uint64_t pad2;
+} Pcps4ArenaHdr;
+
+static GnmDirectMemory g_arena_mem;
+static uint8_t *g_arena_base = NULL;
+static size_t g_arena_top = 0;
+static int g_arena_state = 0; /* 0 untried, 1 ready, -1 unavailable */
+static void *g_arena_free[40];
+static volatile int g_arena_lock = 0;
+
+static void arena_lock(void) {
+    while (__atomic_exchange_n(&g_arena_lock, 1, __ATOMIC_ACQUIRE)) {
+    }
+}
+static void arena_unlock(void) { __atomic_store_n(&g_arena_lock, 0, __ATOMIC_RELEASE); }
+
+static int arena_ready(void) {
+    if (g_arena_state == 0) {
+        memset(&g_arena_mem, 0, sizeof(g_arena_mem));
+        GnmError e = sceGnmDirectMemoryAllocate(
+            &g_arena_mem, PCPS4_ARENA_SIZE, 2u * 1024u * 1024u,
+            GNM_DIRECT_MEMORY_TYPE_WC_GARLIC, GNM_PROT_CPU_GPU_RW);
+        if (e == GNM_ERROR_OK && g_arena_mem.mapped) {
+            g_arena_base = (uint8_t *)g_arena_mem.mapped;
+            g_arena_state = 1;
+        } else {
+            g_arena_state = -1;
+        }
+    }
+    return g_arena_state == 1;
+}
+
+static int arena_owns(const void *p) {
+    return g_arena_state == 1 && (const uint8_t *)p >= g_arena_base &&
+           (const uint8_t *)p < g_arena_base + PCPS4_ARENA_SIZE;
+}
+
+static void *arena_alloc(size_t size, size_t alignment) {
+    if (alignment < 16) alignment = 16;
+    size_t need = size + alignment + PCPS4_ARENA_HDR;
+    uint32_t cls = 7;
+    while (((size_t)1 << cls) < need) cls++;
+    if (cls >= 40) return NULL;
+    arena_lock();
+    uint8_t *raw = NULL;
+    if (g_arena_free[cls]) {
+        raw = (uint8_t *)g_arena_free[cls];
+        g_arena_free[cls] = *(void **)raw;
+    } else {
+        size_t blk = (size_t)1 << cls;
+        size_t top = (g_arena_top + 255) & ~(size_t)255;
+        if (top + blk <= PCPS4_ARENA_SIZE) {
+            raw = g_arena_base + top;
+            g_arena_top = top + blk;
+        }
+    }
+    arena_unlock();
+    if (!raw) return NULL;
+    uintptr_t user = ((uintptr_t)raw + PCPS4_ARENA_HDR + alignment - 1) & ~(uintptr_t)(alignment - 1);
+    Pcps4ArenaHdr *h = (Pcps4ArenaHdr *)(user - PCPS4_ARENA_HDR);
+    h->magic = PCPS4_ARENA_MAGIC;
+    h->cls = cls;
+    h->raw = raw;
+    return (void *)user;
+}
+
+static void arena_release(void *ptr) {
+    Pcps4ArenaHdr *h = (Pcps4ArenaHdr *)((uint8_t *)ptr - PCPS4_ARENA_HDR);
+    if (h->magic != PCPS4_ARENA_MAGIC) return;
+    uint32_t cls = h->cls;
+    void *raw = h->raw;
+    h->magic = 0;
+    arena_lock();
+    *(void **)raw = g_arena_free[cls];
+    g_arena_free[cls] = raw;
+    arena_unlock();
+}
