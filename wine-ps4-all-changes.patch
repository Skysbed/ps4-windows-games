--- /dev/null
+++ b/include/wine/ps4_signals.h
@@ -0,0 +1,15 @@
+#ifndef __WINE_PS4_SIGNALS_H
+#define __WINE_PS4_SIGNALS_H
+/* The toolchain's headers carry Linux signal numbers, and libc hands them to the PS4 kernel unchanged.
+ * Linux's SIGUSR1 (10) is the kernel's SIGBUS, so a general protection fault entered Wine's suspend
+ * handler, which returned to the same instruction forever. Include after <signal.h>. */
+#ifdef __ORBIS__
+#include <signal.h>
+#undef SIGBUS
+#undef SIGUSR1
+#undef SIGUSR2
+#define SIGBUS  10
+#define SIGUSR1 30
+#define SIGUSR2 31
+#endif
+#endif
