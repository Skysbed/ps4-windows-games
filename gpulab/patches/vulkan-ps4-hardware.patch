+/* PcPs4 hardware patch: compiled shader code sits at an arbitrary offset inside
+ * a heap buffer, but the GPU fetches instructions from the address in the stage
+ * registers and needs it 256-byte aligned in GPU-visible memory (the vendor
+ * loaders copy it for the same reason). Copy before pointing the registers at it. */
+static void *pcps4_gpu_code(const VkAllocationCallbacks *alloc, const GnmShaderMetadata *md) {
+    if (!md || !md->shadercode || md->shadercodesize == 0) return (void *)md->shadercode;
+    void *dst = vk_ps4_alloc(alloc, md->shadercodesize, 256);
+    if (!dst) return (void *)md->shadercode;
+    memcpy(dst, md->shadercode, md->shadercodesize);
+    return dst;
+}
