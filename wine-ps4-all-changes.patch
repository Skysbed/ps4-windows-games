+    else if (!timeout || timeout->QuadPart == TIMEOUT_INFINITE) requested = 1000000000;
+    data->ps5_sleeps++;
+    data->ps5_sleep_asked += requested;
+    if (requested >= 200000) ps5_log_sleeper( data, "long", requested / 1000, timeout );
+    if (!data->ps5_sleep_since) data->ps5_sleep_since = now;
+    if (now - data->ps5_sleep_since < 2000000) return;
+    if (data->ps5_sleeps >= 20 || data->ps5_sleep_asked >= 500000)
+        ps5_log_sleeper( data, "poll", (now - data->ps5_sleep_since) / 1000, timeout );
+    data->ps5_sleeps = 0;
+    data->ps5_sleep_asked = 0;
+    data->ps5_sleep_since = now;
