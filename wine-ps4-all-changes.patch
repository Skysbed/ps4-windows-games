@@ -0,0 +1,292 @@
+#ifndef __WINE_PS4_NET_ABI_H
+#define __WINE_PS4_NET_ABI_H
+/* The toolchain's socket headers are musl's (Linux numbers and layouts) over a FreeBSD-derived kernel, and libc
+ * passes everything through unchanged. So MSG_DONTWAIT reached the kernel as MSG_WAITALL (a non-blocking recv
+ * hung), TCP_KEEPIDLE as TCP_NOPUSH, IP_TOS as IP_OPTIONS, and msg_flags was read 4 bytes from where the kernel
+ * wrote it, so a truncated datagram looked complete. Include after the system headers.
+ * The numbers are from WinePS4 (iHaiDeeZ/WinePS4, LGPL-2.1-or-later). */
+#ifdef __ORBIS__
+#include <sys/types.h>
+#include <sys/socket.h>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+
+#undef MSG_OOB
+#undef MSG_PEEK
+#undef MSG_DONTROUTE
+#undef MSG_EOR
+#undef MSG_TRUNC
+#undef MSG_CTRUNC
+#undef MSG_WAITALL
+#undef MSG_DONTWAIT
+#undef MSG_EOF
+#undef MSG_NOSIGNAL
+#undef MSG_CMSG_CLOEXEC
+#undef MSG_CONFIRM
+#undef MSG_PROXY
+#undef MSG_FIN
+#undef MSG_SYN
+#undef MSG_RST
+#undef MSG_ERRQUEUE
+#undef MSG_MORE
+#undef MSG_WAITFORONE
+#undef MSG_FASTOPEN
+#undef MSG_ZEROCOPY
+#define MSG_OOB           0x00001
+#define MSG_PEEK          0x00002
+#define MSG_DONTROUTE     0x00004
+#define MSG_EOR           0x00008
+#define MSG_TRUNC         0x00010
+#define MSG_CTRUNC        0x00020
