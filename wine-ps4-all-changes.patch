+    /* runs the system call NUMBER through the instruction at ENTRY */
+    long (*syscall_at)( uintptr_t entry, long number, long a1, long a2, long a3 );
+    long pid, ppid;     /* getpid() and getppid() through the imports */
+};
+/* Finds a syscall instruction in libkernel's exported getppid stub and
+ * proves it runs other system calls before using it; any firmware whose
+ * stubs have that shape passes. The module record (sceKernelGetModuleInfo)
