+ * shows a fixed menu whose cursor moves every second, so a renderer's
+ * drawing can be checked without a console. */
+static NTSTATUS title_menu( struct pw_title_menu *menu )
+{
+#ifdef __PROSPERO__
+    pw_wine_menu( menu );
+    return STATUS_SUCCESS;
+#else
+    static const char *const lines[] = { "Infinite ammo           [off]", "All weapons", "Close" };
