+/* PS4: dup() has been seen to fail on the console.  Try it, then fall back to
+ * fcntl(F_DUPFD), capturing errno straight away so logging cannot clobber it. */
+static int ps4_dup( int fd )
+{
+    int e1, e2, r = dup( fd );
+    if (r != -1) return r;
+    e1 = errno;
+    r = fcntl( fd, F_DUPFD, 0 );
+    e2 = (r == -1) ? errno : 0;
+    PS4LOG("ps4_dup(%d): dup failed errno=%d; F_DUPFD -> %d errno=%d\n", fd, e1, r, e2);
+    if (r == -1) errno = e1;
+    return r;
