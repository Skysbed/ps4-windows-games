diff --git a/libpsbc/psbc_compile.h b/libpsbc/psbc_compile.h
index 000e7e1..3173b03 100644
--- a/libpsbc/psbc_compile.h
+++ b/libpsbc/psbc_compile.h
@@ -56,11 +56,37 @@ typedef struct {
     size_t  size;         /* Total size of data in bytes */
 } PsbcShaderOutput;
 
+/*
+ * Descriptor layout of the pipeline the shader belongs to. Without it a shader that reads a
+ * uniform buffer, texture or sampler compiles against null descriptors and reads zeros.
+ * The caller owns the byte layout of each descriptor set (offset/size per binding); the
+ * shader loads descriptors from set memory at exactly those offsets.
+ */
+typedef struct {
+    uint32_t binding;      /* binding number */
+    uint32_t type;         /* VkDescriptorType (numeric) */
+    uint32_t array_size;   /* descriptor count */
+    uint32_t offset;       /* byte offset of the binding inside the set */
+    uint32_t size;         /* bytes per array element */
+} PsbcBinding;
+
+typedef struct {
+    uint32_t           binding_count;
+    const PsbcBinding* bindings;
+} PsbcSetLayout;
+
+typedef struct {
+    uint32_t             num_sets;
+    const PsbcSetLayout* sets;
+    uint32_t             address32_hi;  /* upper 32 bits of every descriptor-set address */
+} PsbcDescriptorLayout;
+
 typedef struct {
     PsbcTarget  target;
     PsbcStage   stage;
     const char* entrypoint;  /* Default: "main" */
     bool        optimise;    /* Default: true */
+    const PsbcDescriptorLayout* layout;  /* optional; NULL = no descriptors */
 } PsbcCompileOptions;
 
 /* === API === */
