+  for(i=0;i<n;i++){
+   size_t used;int status=pw_vk_spsc_take(&list[i]->stream,next_replay,scratch+*bytes,PW_VK_BATCH_SCRATCH-*bytes,&used);
+   if(status==PW_VK_STREAM_PENDING)continue;
