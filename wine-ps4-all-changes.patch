+/***********************************************************************
+ *           window surfaces
+ */
+static void ps5_surface_set_clip( struct window_surface *surface, const RECT *rects, UINT count )
+{
+}
+
+static BOOL ps5_surface_flush( struct window_surface *surface, const RECT *rect, const RECT *dirty,
+                               const BITMAPINFO *color_info, const void *color_bits, BOOL shape_changed,
+                               const BITMAPINFO *shape_info, const void *shape_bits )
+{
+    struct ps5_window *window;
+    UINT stride = color_info->bmiHeader.biWidth * 4;
+    RECT target, clip = {0, 0, screen_width, screen_height};
+    INT y;
+
+    pthread_mutex_lock( &screen_lock );
+    if ((window = find_window( surface->hwnd )) && window->shown)
+    {
+        /* dirty is relative to the surface, whose origin is the visible rect's */
+        target = *dirty;
+        OffsetRect( &target, window->visible.left, window->visible.top );
+        if (intersect_rect( &target, &target, &clip ) && intersect_rect( &target, &target, &window->visible ))
+        {
+            for (y = target.top; y < target.bottom; y++)
+            {
+                const BYTE *src = (const BYTE *)color_bits + (y - window->visible.top) * stride +
+                                  (target.left - window->visible.left) * 4;
+                memcpy( screen + y * screen_width + target.left, src, (target.right - target.left) * 4 );
+            }
+            present_screen();
+        }
+    }
+    pthread_mutex_unlock( &screen_lock );
+    return TRUE;
+}
+
+static void ps5_surface_destroy( struct window_surface *surface )
+{
+}
+
+static const struct window_surface_funcs ps5_surface_funcs =
+{
+    ps5_surface_set_clip,
+    ps5_surface_flush,
+    ps5_surface_destroy
+};
+
+static BOOL ps5_CreateWindowSurface( HWND hwnd, BOOL layered, const RECT *surface_rect,
+                                     struct window_surface **surface )
+{
+    char buffer[FIELD_OFFSET( BITMAPINFO, bmiColors[256] )];
+    BITMAPINFO *info = (BITMAPINFO *)buffer;
+    struct window_surface *previous = *surface;
+
+    if (previous && previous->funcs == &ps5_surface_funcs && EqualRect( &previous->rect, surface_rect ))
+        return TRUE;
+
+    memset( info, 0, sizeof(*info) );
+    info->bmiHeader.biSize        = sizeof(info->bmiHeader);
+    info->bmiHeader.biWidth       = surface_rect->right - surface_rect->left;
+    info->bmiHeader.biHeight      = -(surface_rect->bottom - surface_rect->top); /* top-down */
+    info->bmiHeader.biPlanes      = 1;
+    info->bmiHeader.biBitCount    = 32;
+    info->bmiHeader.biSizeImage   = get_dib_image_size( info );
+    info->bmiHeader.biCompression = BI_RGB;
+
+    *surface = window_surface_create( sizeof(**surface), &ps5_surface_funcs, hwnd, surface_rect, info, 0 );
+    if (previous) window_surface_release( previous );
+    return TRUE;
+}
+
+/***********************************************************************
+ *           windows
+ */
+/* Let the server wake this thread when the title posts input, as a
+ * display connection's fd does for the other drivers. Once per thread. */
+static void register_input_fd(void)
+{
+    DWORD tid = GetCurrentThreadId();
+    HANDLE handle;
+    UINT i;
+    int fd;
+
+    if (!input_fd || (fd = input_fd()) == -1) return;
+    pthread_mutex_lock( &screen_lock );
+    for (i = 0; i < input_thread_count; i++) if (input_threads[i] == tid) break;
+    if (i < input_thread_count || input_thread_count == PS5_MAX_WINDOWS)
+    {
+        pthread_mutex_unlock( &screen_lock );
+        return;
+    }
+    input_threads[input_thread_count++] = tid;
+    pthread_mutex_unlock( &screen_lock );
+
+    if (wine_server_fd_to_handle( fd, GENERIC_READ | SYNCHRONIZE, 0, &handle )) return;
+    SERVER_START_REQ( set_queue_fd )
+    {
+        req->handle = wine_server_obj_handle( handle );
+        wine_server_call( req );
+    }
+    SERVER_END_REQ;
+    NtClose( handle );
+}
+
+static BOOL ps5_CreateWindow( HWND hwnd )
+{
+    register_input_fd();
+    return TRUE;
+}
+
+static void ps5_WindowPosChanged( HWND hwnd, HWND insert_after, HWND owner_hint, UINT swp_flags,
+                                  const struct window_rects *new_rects, struct window_surface *surface )
+{
+    struct ps5_window *window;
+    BOOL shown = (NtUserGetWindowLongW( hwnd, GWL_STYLE ) & WS_VISIBLE) &&
+                 NtUserGetAncestor( hwnd, GA_PARENT ) == get_desktop_window();
+    BOOL repaint = FALSE;
+
+    pthread_mutex_lock( &screen_lock );
+    if (!(window = find_window( hwnd )) && shown && window_count < PS5_MAX_WINDOWS)
+    {
+        window = &windows[window_count++];
+        window->hwnd = hwnd;
+        window->shown = FALSE;
+    }
+    if (window)
+    {
+        if (window->shown && (!shown || !EqualRect( &window->visible, &new_rects->visible )))
+        {
+            clear_screen_rect( &window->visible );
+            present_screen();
+        }
+        /* a window just shown may have painted before it had this surface */
+        repaint = shown && !window->shown;
+        window->visible = new_rects->visible;
+        window->shown = shown;
+    }
+    pthread_mutex_unlock( &screen_lock );
+    if (repaint) NtUserRedrawWindow( hwnd, NULL, 0, RDW_INVALIDATE | RDW_ERASE | RDW_FRAME | RDW_ALLCHILDREN );
+}
+
+static void ps5_DestroyWindow( HWND hwnd )
+{
+    struct ps5_window *window;
+
+    pthread_mutex_lock( &screen_lock );
+    if ((window = find_window( hwnd )))
+    {
+        if (window->shown)
+        {
+            clear_screen_rect( &window->visible );
+            present_screen();
+        }
+        *window = windows[--window_count];
+    }
+    pthread_mutex_unlock( &screen_lock );
+}
+
+/* No explorer sizes the desktop the server created: make it the monitor. */
+static void ps5_SetDesktopWindow( HWND hwnd )
+{
+    RECT rect = {0, 0, screen_width, screen_height};
+
+    SERVER_START_REQ( set_window_pos )
+    {
+        req->handle    = wine_server_user_handle( hwnd );
+        req->previous  = 0;
+        req->swp_flags = SWP_NOZORDER;
+        req->window    = wine_server_rectangle( rect );
+        req->client    = req->window;
+        wine_server_call( req );
+    }
+    SERVER_END_REQ;
+
+    /* the prefix may hold another driver's display config: publish ours,
+     * which also gives the server the monitor that bounds the cursor */
+    if (!display_published)
+    {
+        display_published = TRUE;
+        update_display_cache( TRUE );
+    }
+}
+
+/***********************************************************************
+ *           input
+ */
+/* the most recently shown top-level window, or 0 */
+static HWND last_shown_window(void)
+{
+    HWND hwnd = 0;
+    UINT i;
+
+    pthread_mutex_lock( &screen_lock );
+    for (i = window_count; i > 0; i--)
+        if (windows[i - 1].shown) { hwnd = windows[i - 1].hwnd; break; }
+    pthread_mutex_unlock( &screen_lock );
+    return hwnd;
+}
+
+static void send_mouse( HWND hwnd, DWORD flags, INT x, INT y )
+{
+    INPUT input = {.type = INPUT_MOUSE};
+
+    input.mi.dx = x;
+    input.mi.dy = y;
+    input.mi.dwFlags = flags;
+    NtUserSendHardwareInput( hwnd, 0, &input, 0 );
+}
+
+/* The pointer's position as the server keeps it, in screen coordinates. */
+static BOOL server_cursor_pos( POINT *pos )
+{
+    struct object_lock lock = OBJECT_LOCK_INIT;
+    const desktop_shm_t *desktop_shm;
+    NTSTATUS status;
+
+    while ((status = get_shared_desktop( &lock, &desktop_shm )) == STATUS_PENDING)
+    {
+        pos->x = desktop_shm->cursor.x;
+        pos->y = desktop_shm->cursor.y;
+    }
+    return !status;
+}
+
+/* delta along one axis from pos, stopped at a shown edge (low or high - 1)
+ * that is not the screen's own (0 or screen_high - 1) */
+static INT shown_motion( INT pos, INT delta, INT low, INT high, INT screen_high )
+{
+    if (delta < 0 && low > 0 && pos + delta < low) return min( low - pos, 0 );
+    if (delta > 0 && high < screen_high && pos + delta > high - 1) return max( high - 1 - pos, 0 );
+    return delta;
+}
+
+/* The title's mouse and stick move the pointer by relative motion, as a
+ * mouse does. The server keeps it inside ClipCursor's rectangle and still
+ * reports the motion (WM_INPUT, WM_MOUSEMOVE) while it is held against an
+ * edge, which is what scrolls a strategy game's map, and SetCursorPos moves
+ * the same pointer, as mouse look expects. Where a frame shows only part of
+ * the screen (one window, or a smaller display mode), it stops at what is
+ * shown. It starts in the middle of the first frame. */
+static void move_cursor( HWND hwnd, INT dx, INT dy )
+{
+    static BOOL placed;
+    RECT shown;
+    POINT pos;
+
+    pthread_mutex_lock( &screen_lock );
+    shown = view;
+    pthread_mutex_unlock( &screen_lock );
+    /* win32u coalesces a driver's motion until a button or NOCOALESCE sends
+     * it; each move goes to the server now, so the position read back is it */
+    if (!placed)
+    {
+        placed = TRUE;
+        send_mouse( hwnd, MOUSEEVENTF_MOVE | MOUSEEVENTF_ABSOLUTE | MOUSEEVENTF_MOVE_NOCOALESCE,
+                    (shown.left + shown.right) / 2, (shown.top + shown.bottom) / 2 );
+    }
+    if (!server_cursor_pos( &pos )) return;
+    dx = shown_motion( pos.x, dx, shown.left, shown.right, screen_width );
+    dy = shown_motion( pos.y, dy, shown.top, shown.bottom, screen_height );
+    if (dx || dy) send_mouse( hwnd, MOUSEEVENTF_MOVE | MOUSEEVENTF_MOVE_NOCOALESCE, dx, dy );
+    if (!server_cursor_pos( &pos )) return;
+    pthread_mutex_lock( &screen_lock );
+    if (cursor.x != pos.x || cursor.y != pos.y)
+    {
+        cursor = pos;
+        if (cursor_image) present_screen();     /* the pointer moved on screen */
+    }
+    pthread_mutex_unlock( &screen_lock );
+}
+
+/* The keys a PC keyboard sends with an E0 prefix. MAPVK_VK_TO_VSC gives
+ * their scan code without it (the arrows share theirs with the keypad), so
+ * DirectInput, which reads the scan code and the extended flag, would see
+ * the keypad's 8 for VK_UP. */
+static BOOL is_extended_key( WORD vk )
+{
+    switch (vk)
+    {
+    case VK_UP: case VK_DOWN: case VK_LEFT: case VK_RIGHT:
+    case VK_INSERT: case VK_DELETE: case VK_HOME: case VK_END:
+    case VK_PRIOR: case VK_NEXT: case VK_RCONTROL: case VK_RMENU:
+    case VK_LWIN: case VK_RWIN: case VK_APPS: case VK_DIVIDE:
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static BOOL ps5_ProcessEvents( DWORD mask )
+{
+    static const DWORD button_flags[3][2] =
+    {
+        {MOUSEEVENTF_LEFTUP, MOUSEEVENTF_LEFTDOWN},
+        {MOUSEEVENTF_RIGHTUP, MOUSEEVENTF_RIGHTDOWN},
+        {MOUSEEVENTF_MIDDLEUP, MOUSEEVENTF_MIDDLEDOWN},
+    };
+    struct ps5_input event;
+    HWND hwnd = NtUserGetForegroundWindow();
+    UINT processed = 0;
+    BOOL polled = FALSE;
+
+    if (!next_input) return FALSE;
+    if (!hwnd && (hwnd = last_shown_window()))
+    {
+        /* no window manager activates windows here: the newest one gets
+         * the foreground, so keyboard input has somewhere to go */
+        NtUserSetForegroundWindow( hwnd );
+    }
+    if (input_fd)
+    {
+        /* drain the wake pipe first: input posted from now on wakes again */
+        char buffer[64];
+        int fd = input_fd();
+        if (fd != -1)
+        {
+            while (read( fd, buffer, sizeof(buffer) ) > 0) {}
+            polled = TRUE;
+        }
+    }
+    while (processed < PS5_INPUT_BATCH && next_input( &event ))
+    {
+        INPUT input = {.type = INPUT_KEYBOARD};
+
+        processed++;
+        switch (event.type)
+        {
+        case 1:
+            input.ki.wVk = event.code;
+            input.ki.wScan = NtUserMapVirtualKeyEx( event.code, MAPVK_VK_TO_VSC, NtUserGetKeyboardLayout( 0 ));
+            input.ki.dwFlags = event.down ? 0 : KEYEVENTF_KEYUP;
+            if (is_extended_key( event.code )) input.ki.dwFlags |= KEYEVENTF_EXTENDEDKEY;
+            NtUserSendHardwareInput( hwnd, 0, &input, 0 );
+            break;
+        case 2:
+            move_cursor( hwnd, event.x, event.y );
+            break;
+        case 3:
+            if (event.code < 3) send_mouse( hwnd, button_flags[event.code][event.down != 0], 0, 0 );
+            break;
+        }
+    }
+    /* The wake pipe is every GUI thread's queue fd, so a byte sets QS_DRIVER
+     * on all their queues while one of them drains it and takes the events;
+     * a byte can also come after its event was taken here. Either way this
+     * thread finds nothing, and unless it reports the fd as handled, win32u
+     * neither clears its QS_DRIVER nor re-arms the fd: a zero-timeout
+     * message wait (DirectInput's GetDeviceState) then spins until the next
+     * input. A byte still in the pipe makes the re-armed fd fire again. */
+    return processed != 0 || polled;
+}
+
+/***********************************************************************
+ *           cursor
+ */
+/* A monochrome cursor: the mask bitmap holds the AND mask over the XOR mask.
+ * Invert pixels cannot be drawn over a copy of the screen: they are black.
+ * Adapted from winewayland.drv, itself from wineandroid.drv. */
+static UINT32 *mono_cursor( HBITMAP bitmap, UINT *width, UINT *height )
+{
+    BITMAP bm;
+    BYTE *mask = NULL;
+    UINT32 *image = NULL;
+    UINT stride, i, j;
+
+    if (!NtGdiExtGetObjectW( bitmap, sizeof(bm), &bm ) || bm.bmHeight < 2) return NULL;
+    stride = ((bm.bmWidth + 15) >> 3) & ~1;
+    if (!(mask = malloc( stride * bm.bmHeight )) ||
+        !NtGdiGetBitmapBits( bitmap, stride * bm.bmHeight, mask ) ||
+        !(image = malloc( bm.bmWidth * (bm.bmHeight / 2) * 4 )))
+        goto done;
+    *width = bm.bmWidth;
+    *height = bm.bmHeight / 2;
+    for (i = 0; i < *height; i++)
+        for (j = 0; j < *width; j++)
+        {
+            int and = (mask[i * stride + j / 8] << (j % 8)) & 0x80;
+            int xor = (mask[(i + *height) * stride + j / 8] << (j % 8)) & 0x80;
+            image[i * *width + j] = and && !xor ? 0 : xor && !and ? 0xffffffff : 0xff000000;
+        }
+done:
+    free( mask );
+    return image;
+}
+
+/* A color cursor, its alpha from the bitmap or else from the mask. */
+static UINT32 *color_cursor( HDC hdc, HBITMAP color, HBITMAP mask, UINT *width, UINT *height )
+{
+    char buffer[FIELD_OFFSET( BITMAPINFO, bmiColors[256] )];
+    BITMAPINFO *info = (BITMAPINFO *)buffer;
+    BYTE *mask_bits = NULL;
+    UINT32 *image = NULL;
+    BOOL has_alpha = FALSE;
+    BITMAP bm;
+    UINT i, j;
+
+    if (!NtGdiExtGetObjectW( color, sizeof(bm), &bm )) return NULL;
+    memset( info, 0, sizeof(info->bmiHeader) );
+    info->bmiHeader.biSize = sizeof(info->bmiHeader);
+    info->bmiHeader.biWidth = bm.bmWidth;
+    info->bmiHeader.biHeight = -bm.bmHeight;
+    info->bmiHeader.biPlanes = 1;
+    info->bmiHeader.biBitCount = 32;
+    info->bmiHeader.biCompression = BI_RGB;
+    info->bmiHeader.biSizeImage = bm.bmWidth * bm.bmHeight * 4;
+    if (!(image = malloc( info->bmiHeader.biSizeImage )) ||
+        !NtGdiGetDIBitsInternal( hdc, color, 0, bm.bmHeight, image, info, DIB_RGB_COLORS, 0, 0 ))
+        goto failed;
+    for (i = 0; i < (UINT)(bm.bmWidth * bm.bmHeight) && !has_alpha; i++)
+        has_alpha = (image[i] & 0xff000000) != 0;
+    if (!has_alpha)
+    {
+        UINT width_bytes = (bm.bmWidth + 31) / 32 * 4;
+        info->bmiHeader.biBitCount = 1;
+        info->bmiHeader.biSizeImage = width_bytes * bm.bmHeight;
+        if (!(mask_bits = malloc( info->bmiHeader.biSizeImage )) ||
+            !NtGdiGetDIBitsInternal( hdc, mask, 0, bm.bmHeight, mask_bits, info, DIB_RGB_COLORS, 0, 0 ))
+            goto failed;
+        for (i = 0; i < (UINT)bm.bmHeight; i++)
+            for (j = 0; j < (UINT)bm.bmWidth; j++)
+                if (!((mask_bits[i * width_bytes + j / 8] << (j % 8)) & 0x80))
+                    image[i * bm.bmWidth + j] |= 0xff000000;
+                else
+                    image[i * bm.bmWidth + j] = 0;
+        free( mask_bits );
+    }
+    *width = bm.bmWidth;
+    *height = bm.bmHeight;
+    return image;
+failed:
+    free( mask_bits );
+    free( image );
+    return NULL;
+}
+
+/* The bounding box of an image's non-transparent pixels, empty if none */
+static RECT visible_box( const UINT32 *image, UINT width, UINT height )
+{
+    RECT box = {width, height, 0, 0};
+    UINT x, y;
+
+    for (y = 0; y < height; y++)
+        for (x = 0; x < width; x++)
+        {
+            if (!(image[y * width + x] >> 24)) continue;
+            box.left = min( box.left, (LONG)x );
+            box.top = min( box.top, (LONG)y );
+            box.right = max( box.right, (LONG)x + 1 );
+            box.bottom = max( box.bottom, (LONG)y + 1 );
+        }
+    if (box.right <= box.left) SetRectEmpty( &box );
+    return box;
+}
+
+static void ps5_SetCursor( HWND hwnd, HCURSOR handle )
+{
+    UINT32 *image = NULL, *old;
+    UINT width = 0, height = 0;
+    ICONINFO info;
+    RECT box = {0, 0, 0, 0};
+
+    if (handle && NtUserGetIconInfo( handle, &info, NULL, NULL, NULL, 0 ))
+    {
+        if (info.hbmColor)
+        {
+            HDC hdc = NtGdiCreateCompatibleDC( 0 );
+            image = color_cursor( hdc, info.hbmColor, info.hbmMask, &width, &height );
+            NtGdiDeleteObjectApp( hdc );
+            NtGdiDeleteObjectApp( info.hbmColor );
+        }
+        else image = mono_cursor( info.hbmMask, &width, &height );
+        if (info.hbmMask) NtGdiDeleteObjectApp( info.hbmMask );
+        if (image && (info.xHotspot >= width || info.yHotspot >= height))
+            info.xHotspot = info.yHotspot = 0;
+        if (image) box = visible_box( image, width, height );
+    }
+    pthread_mutex_lock( &screen_lock );
+    old = cursor_image;
+    cursor_image = image;
+    cursor_width = width;
+    cursor_height = height;
+    cursor_box = box;
+    if (image) cursor_hotspot = (POINT){info.xHotspot, info.yHotspot};
+    if (old || image) present_screen();
+    pthread_mutex_unlock( &screen_lock );
+    free( old );
+    TRACE( "cursor %p: %ux%u\n", handle, width, height );
+}
+
+#ifdef SONAME_LIBVULKAN
+/* Vulkan frames reach the screen through the GPU driver's own video output
+ * (patch 0460), which this driver does not compose, so after each present
+ * libvulkan.prx shows the cursor with VideoOut's hardware cursor
+ * (pw_videoout_cursor): the image, NULL when hidden, at its place on the
+ * desktop, which the output shows whole. */
+void ps5drv_vulkan_cursor( void *vulkan_handle )
+{
+    static int (*show)( const UINT32 *, UINT, UINT, INT, INT, UINT, UINT );
+    static BOOL looked;
+
+    if (!looked)
+    {
+        looked = TRUE;
+        show = dlsym( vulkan_handle, "pw_videoout_cursor" );
+    }
+    if (!show) return;
+    pthread_mutex_lock( &screen_lock );
+    show( cursor_width && cursor_height ? cursor_image : NULL, cursor_width, cursor_height,
+          cursor.x - cursor_hotspot.x, cursor.y - cursor_hotspot.y, screen_width, screen_height );
+    pthread_mutex_unlock( &screen_lock );
+}
+#endif
+
+static BOOL ps5_GetCursorPos( POINT *pos )
+{
+    /* the server's position is the pointer's: every move goes through it */
+    return TRUE;
+}
+
+static BOOL ps5_SetCursorPos( INT x, INT y )
+{
+    pthread_mutex_lock( &screen_lock );
+    cursor.x = x;
+    cursor.y = y;
+    if (cursor_image) present_screen();
+    pthread_mutex_unlock( &screen_lock );
+    return TRUE;
+}
+
+#ifdef SONAME_LIBVULKAN
+
+static int (*release_display)(void);
+
+static VkResult ps5_vulkan_surface_create( struct client_surface *client, const struct vulkan_instance *instance,
+                                           VkSurfaceKHR *handle )
+{
+    VkDisplaySurfaceCreateInfoKHR info = {.sType = VK_STRUCTURE_TYPE_DISPLAY_SURFACE_CREATE_INFO_KHR};
+    VkDisplayModePropertiesKHR modes[16];
+    VkDisplayPropertiesKHR display;
+    VkPhysicalDevice physical;
+    uint32_t count = 1, chosen = 0, i;
+    VkResult res;
+
+    /* A host driver may open the video output as soon as its displays are
+     * queried (RADV does; ps5vk waits for the swapchain), so the title lets
+     * go of it first. */
+    if (release_display && release_display())
+    {
+        ERR( "the title kept the video output\n" );
+        return VK_ERROR_NATIVE_WINDOW_IN_USE_KHR;
+    }
+
+    /* one GPU and one display, always in its native mode (the one at its physical
+     * resolution, else the first); the desktop is scaled to it, never the reverse */
+    res = instance->p_vkEnumeratePhysicalDevices( instance->host.instance, &count, &physical );
+    if (res < VK_SUCCESS || !count) goto failed;
+    count = 1;
+    res = instance->p_vkGetPhysicalDeviceDisplayPropertiesKHR( physical, &count, &display );
+    if (res < VK_SUCCESS || !count) goto failed;
+    count = ARRAY_SIZE(modes);
+    res = instance->p_vkGetDisplayModePropertiesKHR( physical, display.display, &count, modes );
+    if (res < VK_SUCCESS || !count) goto failed;
+    for (i = 0; i < count; i++)
+    {
+        TRACE( "mode %u: %ux%u %u mHz\n", i, modes[i].parameters.visibleRegion.width,
+               modes[i].parameters.visibleRegion.height, modes[i].parameters.refreshRate );
+        if (modes[i].parameters.visibleRegion.width == display.physicalResolution.width &&
+            modes[i].parameters.visibleRegion.height == display.physicalResolution.height)
+        {
+            chosen = i;
+            break;
+        }
+    }
+
+    info.displayMode = modes[chosen].displayMode;
+    info.planeIndex = 0;
+    info.planeStackIndex = 0;
+    info.transform = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR;
+    info.globalAlpha = 1.0f;
+    info.alphaMode = VK_DISPLAY_PLANE_ALPHA_OPAQUE_BIT_KHR;
+    info.imageExtent = modes[chosen].parameters.visibleRegion;
+    res = instance->p_vkCreateDisplayPlaneSurfaceKHR( instance->host.instance, &info, NULL, handle );
+    TRACE( "%s: mode %u of %u, %ux%u display plane surface 0x%s, res %d\n", debugstr_client_surface( client ),
+           chosen, count, info.imageExtent.width, info.imageExtent.height, wine_dbgstr_longlong( *handle ), res );
+    return res;
+
+failed:
+    ERR( "no host display (%u found), res %d\n", count, res );
+    return res < VK_SUCCESS ? res : VK_ERROR_INITIALIZATION_FAILED;
+}
+
+static VkBool32 ps5_get_physical_device_presentation_support( struct vulkan_physical_device *physical_device,
+                                                              uint32_t index )
+{
