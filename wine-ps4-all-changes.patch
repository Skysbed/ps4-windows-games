@@ -381,7 +382,62 @@ LONGLONG WINAPI RtlGetSystemTimePrecise( void )
  */
 BOOL WINAPI DECLSPEC_HOTPATCH RtlQueryPerformanceCounter( LARGE_INTEGER *counter )
 {
+#if defined(__i386__) || defined(__x86_64__)
+    static struct pw_qpc_anchor anchor;
+    static LONG gate, disabled, activated;
+    static DECLSPEC_ALIGN(8) LONGLONG last;
+    uint64_t value;
+    unsigned lo, hi;
+    LONGLONG previous, result;
+    if (ReadAcquire( &disabled ) && !ReadAcquire( &activated ))
+    {
+        NtQueryPerformanceCounter( counter, NULL );
+        return TRUE;
+    }
+    if (!ReadAcquire( &disabled ) && !InterlockedCompareExchange( &gate, 1, 0 ))
+    {
+        int have = 0;
+        if (anchor.validated)
+        {
+            __asm__ volatile( "lfence; rdtsc" : "=a"(lo), "=d"(hi) :: "memory" );
+            have = pw_qpc_read_anchor( &anchor, ((uint64_t)hi << 32) | lo, &value );
+        }
+        if (!have)
+        {
+            struct pw_qpc_anchor fresh;
+            if (NtQueryInformationProcess( NtCurrentProcess(), (PROCESSINFOCLASS)PW_QPC_PROCESS_INFO, &fresh, sizeof(fresh), NULL ) ||
+                !pw_qpc_read_anchor( &fresh, fresh.tsc, &value ))
+                InterlockedExchange( &disabled, 1 );
+            else
+            {
+                anchor = fresh;
+                __asm__ volatile( "lfence; rdtsc" : "=a"(lo), "=d"(hi) :: "memory" );
+                have = pw_qpc_read_anchor( &anchor, ((uint64_t)hi << 32) | lo, &value );
+            }
+        }
+        if (have)
+        {
+            counter->QuadPart = value;
+            InterlockedExchange( &activated, 1 );
+        }
+        else NtQueryPerformanceCounter( counter, NULL );
+        InterlockedExchange( &gate, 0 );
+    }
+    else NtQueryPerformanceCounter( counter, NULL );
+    /* Reanchoring uncertainty must not cause a caller's clock to go backward.
+     * The slow and fast paths participate in the same monotonic maximum. */
+    previous = InterlockedCompareExchange64( &last, 0, 0 );
+    do
+    {
+        result = counter->QuadPart > previous ? counter->QuadPart : previous;
+        value = InterlockedCompareExchange64( &last, result, previous );
+        if ((LONGLONG)value == previous) break;
+        previous = value;
+    } while (1);
+    counter->QuadPart = result;
+#else
     NtQueryPerformanceCounter( counter, NULL );
+#endif
     return TRUE;
 }
 
