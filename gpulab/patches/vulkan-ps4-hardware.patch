                         pipe->vs_regs = vs->registers;
+                        {
+                            void *gpu_code = pcps4_place_shader_code(alloc, &metadata);
+                            if (gpu_code) sceGnmVsRegsSetAddress(&pipe->vs_regs, gpu_code);
+                        }
