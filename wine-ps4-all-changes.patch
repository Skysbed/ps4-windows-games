+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Native module ABI. No guest-addressable state or application pointers. */
+#ifndef WINE_PS5_MUTEX_BACKEND_H
+#define WINE_PS5_MUTEX_BACKEND_H
+#include <stddef.h>
+#include <stdint.h>
+#include "ps5_mutex_word.h"
+#define PW_MUTEX_BACKEND_VERSION 1u
+#define PW_MUTEX_LOOKUP_READY 0
+#define PW_MUTEX_LOOKUP_RETRY 1
+#define PW_MUTEX_LOOKUP_NEGATIVE 2
+#define PW_MUTEX_SLOT_NEGATIVE ((uintptr_t)1)
+#define PW_MUTEX_SLOT_SYNCHRONIZE ((uintptr_t)2)
+#define PW_MUTEX_SLOT_FLAGS ((uintptr_t)3)
+struct pw_mutex_backend
+{
+    uint32_t version, size, word_size, pointer_size;
+    const int *ready;
+    int (*get_word)( uint32_t version, uint32_t tid, uint64_t teb, uint32_t handle,
+                     struct pw_mutex_word **word, uint32_t *token, uint32_t *access );
+};
+static inline int pw_mutex_backend_valid( const struct pw_mutex_backend *api )
+{
+    return api && api->version == PW_MUTEX_BACKEND_VERSION && api->size == sizeof(*api) &&
+        api->word_size == sizeof(struct pw_mutex_word) && api->pointer_size == sizeof(void *) &&
+        api->ready && api->get_word;
+}
+static inline int pw_mutex_backend_ready( const struct pw_mutex_backend *api )
+{
+    return __atomic_load_n( api->ready, __ATOMIC_ACQUIRE );
+}
+static inline struct pw_mutex_word *pw_mutex_slot_word( uintptr_t slot )
+{
+    return (struct pw_mutex_word *)(slot & ~PW_MUTEX_SLOT_FLAGS);
+}
+#endif
diff --git a/include/wine/ps5_mutex_word.h b/include/wine/ps5_mutex_word.h
new file mode 100644
index 0000000..af46715
--- /dev/null
+++ b/include/wine/ps5_mutex_word.h
@@ -0,0 +1,88 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Atomic word primitives for the opt-in in-process mutex backend.
+ * No authority/lifetime policy lives here. The server must freeze before
+ * adopting ownership into legacy fields, and remove the legacy owner/list
+ * reference before publishing fast state. State cells must never be reused
+ * or freed while a cached client can address them. No guest pointers.
+ */
+#ifndef WINE_PS5_MUTEX_WORD_H
+#define WINE_PS5_MUTEX_WORD_H
+#include <assert.h>
+#include <stdint.h>
+
+#define PW_MUTEX_WORD_SLOW (UINT64_C(1) << 63)
+#define PW_MUTEX_WORD_MAX_COUNT UINT32_C(0x7fffffff)
+struct __attribute__((aligned(64))) pw_mutex_word { uint64_t word; };
+
+static inline uint32_t pw_mutex_word_owner(uint64_t word)
+{
+    return (uint32_t)word;
+}
+static inline uint32_t pw_mutex_word_count(uint64_t word)
+{
+    return (uint32_t)(word >> 32) & PW_MUTEX_WORD_MAX_COUNT;
+}
+static inline uint64_t pw_mutex_word_load(const struct pw_mutex_word *cell)
+{
+    return __atomic_load_n(&cell->word, __ATOMIC_ACQUIRE);
+}
+static inline int pw_mutex_word_try_acquire(struct pw_mutex_word *cell, uint32_t token)
+{
+    uint64_t old, next;
+    uint32_t count;
+    if (!token) return 0;
+    old = pw_mutex_word_load(cell);
+    if (old & PW_MUTEX_WORD_SLOW) return 0;
+    count = pw_mutex_word_count(old);
+    if (!old) next = token | (UINT64_C(1) << 32);
+    else
+    {
+        if (pw_mutex_word_owner(old) != token || !count || count == PW_MUTEX_WORD_MAX_COUNT) return 0;
+        next = old + (UINT64_C(1) << 32);
+    }
+    return __atomic_compare_exchange_n(&cell->word, &old, next, 0,
+                                       __ATOMIC_ACQUIRE, __ATOMIC_RELAXED);
+}
+static inline int pw_mutex_word_try_release(struct pw_mutex_word *cell, uint32_t token,
+                                          uint32_t *count_before)
+{
+    uint64_t old, next;
+    uint32_t count;
+    if (!token) return 0;
+    old = pw_mutex_word_load(cell);
+    count = pw_mutex_word_count(old);
+    if ((old & PW_MUTEX_WORD_SLOW) || !count || pw_mutex_word_owner(old) != token) return 0;
+    next = count == 1 ? 0 : old - (UINT64_C(1) << 32);
+    if (!__atomic_compare_exchange_n(&cell->word, &old, next, 0,
+                                     __ATOMIC_RELEASE, __ATOMIC_RELAXED)) return 0;
+    /* Native caller-local storage, never an application output pointer. */
+    *count_before = count;
+    return 1;
+}
+/* Under the server lock. Exactly one entry snapshot is adopted; subsequent
+ * recursive entries see SLOW and keep the existing legacy authority.
+ */
+static inline int pw_mutex_word_freeze(struct pw_mutex_word *cell, uint64_t *snapshot)
+{
+    *snapshot = __atomic_fetch_or(&cell->word, PW_MUTEX_WORD_SLOW, __ATOMIC_ACQ_REL);
+    return !(*snapshot & PW_MUTEX_WORD_SLOW);
+}
+/* Validate representation before removing any owner reference. A count past
+ * MAX stays in ordinary server mode; it is not a guest failure/retirement.
+ */
+static inline int pw_mutex_word_compose(uint32_t token, uint32_t count, uint64_t *word)
+{
+    if (count > PW_MUTEX_WORD_MAX_COUNT || (!!token != !!count)) return 0;
+    *word = token | ((uint64_t)count << 32);
+    return 1;
+}
+/* Under the server lock, only after all waiter, abandonment, retirement,
+ * operation-depth, thread-lifetime and module gates permit fast authority.
+ */
+static inline void pw_mutex_word_publish(struct pw_mutex_word *cell, uint64_t word)
+{
+    assert(!(word & PW_MUTEX_WORD_SLOW));
+    assert(pw_mutex_word_load(cell) & PW_MUTEX_WORD_SLOW);
+    __atomic_store_n(&cell->word, word, __ATOMIC_RELEASE);
+}
+#endif
diff --git a/include/wine/ps5_sync_backend.h b/include/wine/ps5_sync_backend.h
new file mode 100644
index 0000000..84f8cfb
--- /dev/null
+++ b/include/wine/ps5_sync_backend.h
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Native module ABI; only native cells and caller-local metadata cross it. */
+#ifndef WINE_PS5_SYNC_BACKEND_H
+#define WINE_PS5_SYNC_BACKEND_H
+#include <stddef.h>
+#include <stdint.h>
+#include "ps5_sync_word.h"
+#define PW_SYNC_BACKEND_VERSION 1u
+#define PW_SYNC_LOOKUP_READY 0
+#define PW_SYNC_LOOKUP_RETRY 1
+#define PW_SYNC_LOOKUP_NEGATIVE 2
+#define PW_SYNC_SLOT_NEGATIVE ((uintptr_t)1)
+#define PW_SYNC_SLOT_SYNCHRONIZE ((uintptr_t)2)
+#define PW_SYNC_SLOT_MODIFY ((uintptr_t)4)
+#define PW_SYNC_SLOT_FLAGS ((uintptr_t)7)
+enum pw_sync_operation { PW_SYNC_WAIT, PW_SYNC_SET, PW_SYNC_RESET, PW_SYNC_RELEASE };
+struct pw_sync_backend
+{
+    uint32_t version, size, word_size, pointer_size;
+    const int *ready;
+    int (*get_word)(uint32_t version, uint32_t tid, uint64_t teb, uint32_t handle,
+                    struct pw_sync_word **word, uint32_t *access);
+};
+static inline int pw_sync_backend_valid(const struct pw_sync_backend *api)
+{
+    return api && api->version == PW_SYNC_BACKEND_VERSION && api->size == sizeof(*api) &&
+           api->word_size == sizeof(struct pw_sync_word) && api->pointer_size == sizeof(void *) &&
+           api->ready && api->get_word;
+}
+static inline int pw_sync_backend_ready(const struct pw_sync_backend *api)
+{
+    return api && __atomic_load_n(api->ready, __ATOMIC_ACQUIRE);
+}
+static inline struct pw_sync_word *pw_sync_slot_word(uintptr_t slot)
+{
+    return (struct pw_sync_word *)(slot & ~PW_SYNC_SLOT_FLAGS);
+}
+#endif
diff --git a/include/wine/ps5_sync_word.h b/include/wine/ps5_sync_word.h
new file mode 100644
index 0000000..70ce3a3
--- /dev/null
+++ b/include/wine/ps5_sync_word.h
@@ -0,0 +1,109 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Shared event/semaphore state. Native pointers and caller-local outputs only.
+ * Server integration owns eligibility, handle access, queues and lifetime.
+ * The high bit transfers authority to the server; cached cells are never
+ * freed or rebound. Immutable kind/maximum precede publishing a cell pointer.
+ * A failed operation changes neither state nor its output and falls back to
+ * the ordinary server. Successful operations use at most one strong CAS.
+ */
+#ifndef WINE_PS5_SYNC_WORD_H
+#define WINE_PS5_SYNC_WORD_H
+#include <assert.h>
+#include <stdint.h>
+
+#define PW_SYNC_WORD_SLOW (UINT64_C(1) << 63)
+#define PW_SYNC_WORD_MAX_COUNT UINT32_C(0x7fffffff)
+enum pw_sync_kind { PW_SYNC_AUTO_EVENT = 1, PW_SYNC_MANUAL_EVENT, PW_SYNC_SEMAPHORE };
+struct __attribute__((aligned(64))) pw_sync_word
+{
+    uint64_t word;
+    uint32_t kind;
+    uint32_t maximum;
+};
+
+static inline int pw_sync_word_value_valid(const struct pw_sync_word *cell, uint32_t value)
+{
+    if (cell->kind == PW_SYNC_AUTO_EVENT || cell->kind == PW_SYNC_MANUAL_EVENT)
+        return cell->maximum == 1 && value <= 1;
+    return cell->kind == PW_SYNC_SEMAPHORE && cell->maximum &&
+           cell->maximum <= PW_SYNC_WORD_MAX_COUNT && value <= cell->maximum;
+}
+
+/* Server-lock-held initialization, before any native client observes cell. */
+static inline void pw_sync_word_init(struct pw_sync_word *cell, uint32_t kind,
+                                    uint32_t initial, uint32_t maximum)
+{
+    cell->kind = kind;
+    cell->maximum = maximum;
+    assert(pw_sync_word_value_valid(cell, initial));
+    cell->word = PW_SYNC_WORD_SLOW | initial;
+}
+
+static inline uint64_t pw_sync_word_load(const struct pw_sync_word *cell)
+{
+    return __atomic_load_n(&cell->word, __ATOMIC_ACQUIRE);
+}
+
+static inline int pw_sync_word_try_wait(struct pw_sync_word *cell)
+{
+    uint64_t old = pw_sync_word_load(cell), next;
+    if ((old & PW_SYNC_WORD_SLOW) || !old ||
+        !pw_sync_word_value_valid(cell, (uint32_t)old)) return 0;
+    next = cell->kind == PW_SYNC_MANUAL_EVENT ? old : old - 1;
+    /* Even an unchanged manual-event state requires a CAS: a concurrent
+     * server freeze must reject fast acquisition rather than be ignored. */
+    return __atomic_compare_exchange_n(&cell->word, &old, next, 0,
+                                       __ATOMIC_ACQUIRE, __ATOMIC_RELAXED);
+}
+
+static inline int pw_sync_word_try_event(struct pw_sync_word *cell, int set,
+                                        uint32_t *previous)
+{
+    uint64_t old, next;
+    if ((cell->kind != PW_SYNC_AUTO_EVENT && cell->kind != PW_SYNC_MANUAL_EVENT) ||
+        (set != 0 && set != 1)) return 0;
+    old = pw_sync_word_load(cell);
+    if ((old & PW_SYNC_WORD_SLOW) || !pw_sync_word_value_valid(cell, (uint32_t)old)) return 0;
+    next = (uint32_t)set;
+    if (!__atomic_compare_exchange_n(&cell->word, &old, next, 0,
+                                     __ATOMIC_RELEASE, __ATOMIC_RELAXED)) return 0;
+    *previous = (uint32_t)old;
+    return 1;
+}
+
+static inline int pw_sync_word_try_release(struct pw_sync_word *cell, uint32_t count,
+                                          uint32_t *previous)
+{
+    uint64_t old, next;
+    if (cell->kind != PW_SYNC_SEMAPHORE || !count) return 0;
+    old = pw_sync_word_load(cell);
+    if ((old & PW_SYNC_WORD_SLOW) || !pw_sync_word_value_valid(cell, (uint32_t)old) ||
+        count > cell->maximum - (uint32_t)old) return 0;
+    next = old + count;
+    if (!__atomic_compare_exchange_n(&cell->word, &old, next, 0,
+                                     __ATOMIC_RELEASE, __ATOMIC_RELAXED)) return 0;
+    *previous = (uint32_t)old;
+    return 1;
+}
+
+/* Under the server lock, adopt only the first snapshot. Recursive slow
+ * entries must preserve the existing legacy state instead of adopting again. */
+static inline int pw_sync_word_freeze(struct pw_sync_word *cell, uint32_t *snapshot)
+{
+    uint64_t old = __atomic_fetch_or(&cell->word, PW_SYNC_WORD_SLOW, __ATOMIC_ACQ_REL);
+    if (old & PW_SYNC_WORD_SLOW) return 0;
+    *snapshot = (uint32_t)old;
+    return 1;
+}
+
+/* Server-lock-held, only at outermost operation completion with no waiters,
+ * alias/close retirement, debug/module disable or other slow dependency.
+ * Invalid legacy values remain slow; this is not a guest error. */
+static inline int pw_sync_word_publish(struct pw_sync_word *cell, uint32_t value)
+{
+    assert(pw_sync_word_load(cell) & PW_SYNC_WORD_SLOW);
+    if (!pw_sync_word_value_valid(cell, value)) return 0;
+    __atomic_store_n(&cell->word, value, __ATOMIC_RELEASE);
+    return 1;
+}
+#endif
