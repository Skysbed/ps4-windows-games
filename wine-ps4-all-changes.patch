+/* PS4: neither dup() (EPERM) nor fcntl(F_DUPFD) (EINVAL) works for a title
+ * process.  For a descriptor that came from a named file we do not need to
+ * duplicate at all: opening the same path again yields an independent
+ * descriptor on the same file, which is all a mapping or a second handle
+ * needs.  Falls back to plain ps4_dup() for unnamed descriptors. */
+static int ps4_dup_named( int fd, const char *unix_name )
+{
+    int r = ps4_dup( fd ), e;
+    if (r != -1 || !unix_name) return r;
+    e = errno;
+    r = open( unix_name, O_RDWR );
+    if (r == -1) r = open( unix_name, O_RDONLY );
+    PS4LOG("ps4_dup_named(%d,%s): reopen -> %d errno=%d\n", fd, unix_name, r, r == -1 ? errno : 0);
+    if (r == -1) errno = e;
+    return r;
+}
