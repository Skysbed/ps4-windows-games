new file mode 100644
index 0000000..377e58c
--- /dev/null
+++ b/dlls/dnsapi/ps4.c
@@ -0,0 +1,264 @@
+/*
+ * Copyright 2026 WinePS4
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+/*
+ * dnsapi's Unix half on the PS4 (WinePS4), in place of libresolv.c: the PS4 has no libresolv and
+ * no resolv.conf. The DNS servers are the PS4's network settings (port/ps4_ifaddrs.c); without
+ * them DnsQueryConfig failed, and with it GetAdaptersAddresses as a whole (iphlpapi's
+ * dns_info_alloc). Queries for addresses (A) go through getaddrinfo, which is the PS4's resolver
+ * (ps4-kit), and come back as the DNS message dnsapi reads; other types are not found.
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <stdarg.h>
+#include <string.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/types.h>
+#include <sys/socket.h>
+#include <netinet/in.h>
+#include <netdb.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winternl.h"
+#include "winbase.h"
+#include "windns.h"
+#define USE_WS_PREFIX
+#include "ws2def.h"
+#include "ws2ipdef.h"
+
+#include "wine/debug.h"
+#include "dnsapi.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(dnsapi);
+
+extern int ps4_dns_servers( unsigned int *servers, int max );  /* port/ps4_ifaddrs.c */
+
+static unsigned int set_servers[4], set_count;  /* DnsQuery's own servers (only kept) */
+
+static NTSTATUS resolv_get_searchlist( void *args )
+{
+    const struct get_searchlist_params *params = args;
+    const DWORD needed = sizeof(WCHAR);  /* (none: the terminator alone) */
+
+    if (!params->list || *params->len < needed)
+    {
+        *params->len = needed;
+        return !params->list ? ERROR_SUCCESS : ERROR_MORE_DATA;
+    }
+    *params->len = needed;
+    params->list[0] = 0;
+    return ERROR_SUCCESS;
+}
+
+static NTSTATUS resolv_get_serverlist( void *args )
+{
+    const struct get_serverlist_params *params = args;
+    DNS_ADDR_ARRAY *addrs = params->addrs;
+    unsigned int servers[4];
+    DWORD needed, i;
+    int count;
+
+    if (params->family == WS_AF_INET6) return DNS_ERROR_NO_DNS_SERVERS;  /* (IPv4 ones only) */
+    if (!(count = ps4_dns_servers( servers, ARRAY_SIZE(servers) ))) return DNS_ERROR_NO_DNS_SERVERS;
+
+    needed = FIELD_OFFSET(DNS_ADDR_ARRAY, AddrArray[count]);
+    if (!addrs || *params->len < needed)
+    {
+        *params->len = needed;
+        return !addrs ? ERROR_SUCCESS : ERROR_MORE_DATA;
+    }
+    *params->len = needed;
+    memset( addrs, 0, needed );
+    addrs->AddrCount = addrs->MaxCount = count;
+    for (i = 0; i < count; i++)
+    {
+        SOCKADDR_IN *sa = (SOCKADDR_IN *)addrs->AddrArray[i].MaxSa;
+        sa->sin_family = WS_AF_INET;
+        sa->sin_addr.WS_s_addr = servers[i];
+        addrs->AddrArray[i].Data.DnsAddrUserDword[0] = sizeof(*sa);
+    }
+    return ERROR_SUCCESS;
+}
+
+static NTSTATUS resolv_set_serverlist( void *args )
+{
+    const IP4_ARRAY *addrs = args;
+    DWORD i;
+
+    set_count = 0;
+    if (!addrs) return ERROR_SUCCESS;
+    for (i = 0; i < addrs->AddrCount && set_count < ARRAY_SIZE(set_servers); i++)
+        set_servers[set_count++] = addrs->AddrArray[i];
+    return ERROR_SUCCESS;
+}
+
+/* a DNS answer message for name: the header, the question, and an A record for each address */
+static int dns_message( const char *name, WORD type, const unsigned int *addrs, int count, int rcode,
+                        unsigned char *buf, DWORD size )
+{
+    const char *label = name;
+    unsigned char *p = buf, *end = buf + size;
+    int i;
+
+    if (size < 12) return -1;
+    memset( p, 0, 12 );
+    p[2] = 0x81;                 /* a response, recursion desired */
+    p[3] = 0x80 | rcode;         /* recursion available */
+    p[5] = 1;                    /* one question */
+    p[7] = count;                /* the answers */
+    p += 12;
+    while (*label)               /* the name, label by label */
+    {
+        const char *dot = strchr( label, '.' );
+        const size_t len = dot ? (size_t)(dot - label) : strlen( label );
+
+        if (!len || len > 63 || p + 1 + len >= end) return -1;
+        *p++ = len;
+        memcpy( p, label, len );
+        p += len;
+        label += len + (dot ? 1 : 0);
+    }
+    if (p + 5 > end) return -1;
+    *p++ = 0;
+    *p++ = type >> 8; *p++ = type;
+    *p++ = 0; *p++ = 1;          /* class IN */
+    for (i = 0; i < count; i++)
+    {
+        if (p + 16 > end) return -1;
+        *p++ = 0xc0; *p++ = 12;  /* the question's name */
+        *p++ = 0; *p++ = 1;      /* A */
+        *p++ = 0; *p++ = 1;      /* IN */
+        *p++ = 0; *p++ = 0; *p++ = 0x01; *p++ = 0x2c;  /* five minutes */
+        *p++ = 0; *p++ = 4;
+        memcpy( p, &addrs[i], 4 );
+        p += 4;
+    }
+    return p - buf;
+}
+
+static NTSTATUS resolv_query( void *args )
+{
+    const struct query_params *params = args;
+    struct addrinfo hints, *res = NULL, *ai;
+    unsigned int addrs[16];
+    int count = 0, len;
+
+    if (params->type == DNS_TYPE_A)
+    {
+        memset( &hints, 0, sizeof(hints) );
+        hints.ai_family = AF_INET;
+        hints.ai_socktype = SOCK_STREAM;
+        if (!getaddrinfo( params->name, NULL, &hints, &res ))
+        {
+            for (ai = res; ai && count < ARRAY_SIZE(addrs); ai = ai->ai_next)
+                if (ai->ai_family == AF_INET)
+                    addrs[count++] = ((struct sockaddr_in *)ai->ai_addr)->sin_addr.s_addr;
+            freeaddrinfo( res );
+        }
+    }
+    else FIXME( "type %u for %s: only addresses (A)\n", params->type, debugstr_a(params->name) );
+    len = dns_message( params->name, params->type, addrs, count, count ? 0 : 3 /* NXDOMAIN */, params->buf,
+                       *params->len );
+    if (len < 0) return DNS_ERROR_RCODE_FORMAT_ERROR;
+    *params->len = len;
+    return ERROR_SUCCESS;
+}
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    resolv_get_searchlist,
+    resolv_get_serverlist,
+    resolv_set_serverlist,
+    resolv_query,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_funcs) == unix_funcs_count );
+
+#ifdef _WIN64
+
+typedef ULONG PTR32;
+
+static NTSTATUS wow64_resolv_get_searchlist( void *args )
+{
+    struct
+    {
+        PTR32  list;
+        PTR32  len;
+    } const *params32 = args;
+
+    struct get_searchlist_params params =
+    {
+        ULongToPtr(params32->list),
+        ULongToPtr(params32->len)
+    };
+
+    return resolv_get_searchlist( &params );
+}
+
+static NTSTATUS wow64_resolv_get_serverlist( void *args )
+{
+    struct
+    {
+        USHORT family;
+        PTR32  addrs;
+        PTR32  len;
+    } const *params32 = args;
+
+    struct get_serverlist_params params =
+    {
+        params32->family,
+        ULongToPtr(params32->addrs),
+        ULongToPtr(params32->len)
+    };
+
+    return resolv_get_serverlist( &params );
+}
+
+static NTSTATUS wow64_resolv_query( void *args )
+{
+    struct
+    {
+        PTR32  name;
+        WORD   type;
+        DWORD  options;
+        PTR32  buf;
+        PTR32  len;
+    } const *params32 = args;
+
+    struct query_params params =
+    {
+        ULongToPtr(params32->name),
+        params32->type,
+        params32->options,
+        ULongToPtr(params32->buf),
+        ULongToPtr(params32->len)
+    };
+
+    return resolv_query( &params );
+}
+
+const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
+{
+    wow64_resolv_get_searchlist,
+    wow64_resolv_get_serverlist,
+    resolv_set_serverlist,
+    wow64_resolv_query,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_wow64_funcs) == unix_funcs_count );
+
+#endif  /* _WIN64 */
