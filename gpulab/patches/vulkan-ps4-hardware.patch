     if (alloc && alloc->pfnAllocation) {
@@ -164,6 +259,10 @@ void *vk_ps4_alloc(const VkAllocationCallbacks *alloc, size_t size, size_t align
     }
     return _aligned_malloc(size, alignment);
 #elif defined(__ORBIS__) || defined(__PS4__)
+    if (arena_ready()) {
+        void *g = arena_alloc(size, alignment);
+        if (g) return g;
+    }
     /* PS4 FreeBSD-based kernel doesn't expose posix_memalign.
      * Always over-allocate and align manually, storing the raw
      * pointer immediately before the aligned address so vk_ps4_free
@@ -208,6 +307,10 @@ void vk_ps4_free(const VkAllocationCallbacks *alloc, void *ptr) {
 #if defined(_MSC_VER)
     _aligned_free(ptr);
 #elif defined(__ORBIS__) || defined(__PS4__)
+    if (arena_owns(ptr)) {
+        arena_release(ptr);
+        return;
+    }
     /* Recover the original malloc pointer stored before the aligned address. */
     free(((void **)ptr)[-1]);
 #else
