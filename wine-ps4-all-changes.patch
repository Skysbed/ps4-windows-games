+/* Startup runs once before request dispatch. Other sites run on the server thread. */
+#ifdef __ORBIS__
+#include <stdio.h>
+#include <errno.h>
+#define WS_DIAG(limit, ...) do {                            \
+    static unsigned int count;                              \
+    if (count < (limit)) {                                  \
+        int saved_errno = errno;                            \
+        FILE *file;                                         \
+        ++count;                                            \
+        file = fopen( "/data/pcps4_ws_diag.log", "a" );      \
+        if (file) {                                         \
+            fprintf( file, __VA_ARGS__ );                   \
+            fclose( file );                                 \
+        }                                                   \
+        errno = saved_errno;                                \
+    }                                                       \
+} while (0)
+#else
+#define WS_DIAG(limit, ...) do {} while (0)
+#endif
