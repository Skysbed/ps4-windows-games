+ if(n>=2&&value[0]=='0'&&(value[1]=='x'||value[1]=='X')){base=16;i=2;}
+ if(i==n)return FALSE;
+ for(;i<n;i++){
+  if(value[i]>='0'&&value[i]<='9')digit=value[i]-'0';
+  else if(base==16&&value[i]>='a'&&value[i]<='f')digit=value[i]-'a'+10;
+  else if(base==16&&value[i]>='A'&&value[i]<='F')digit=value[i]-'A'+10;
