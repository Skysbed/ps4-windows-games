+        !thread->req_toread && !thread->reply_towrite && !thread->req_data && !thread->reply_data &&
+        thread_can_fast_mutex( thread ))
+    {
+        saved_error = thread->error;
+        current = thread;
+        clear_error();
+        ps5_mutex_server_begin();
+        if (try_fast_mutex( thread, handle, release, prev_count ))
+        {
+            thread->ps5_last_req = release ? REQ_release_mutex : REQ_select;
+            /* No timeout or queued waiter is changed by this path. The main
+             * loop maintains shared time at its existing 16 ms cadence.
+             * Take only the watchdog timestamp here, without gettimeofday
+             * or republishing all of KUSER_SHARED_DATA on every mutex op. */
+            thread->ps5_last_req_time = monotonic_counter();
