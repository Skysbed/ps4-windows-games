+/* the layout of PwWineInput in wine/ps5/pw_wine_sink.h */
+struct ps5_input
+{
+    UINT type;              /* 1 key, 2 mouse move, 3 mouse button */
+    UINT code;              /* virtual key, or button 0 left 1 right 2 middle */
+    INT  x, y;              /* mouse move: relative motion in desktop pixels */
+    UINT down;
+};
+
+enum { PS5_MAX_WINDOWS = 64, PS5_INPUT_BATCH = 64 };
+
+struct ps5_window
+{
+    HWND hwnd;
+    RECT visible;           /* screen coordinates */
+    BOOL shown;
+};
+
+static int (*present_frame)( const void *bgra, UINT width, UINT height, UINT stride );
+static int (*next_input)( struct ps5_input *input );
+static int (*input_fd)(void);
+
+static pthread_mutex_t screen_lock = PTHREAD_MUTEX_INITIALIZER;
+static UINT screen_width = 800, screen_height = 600;
+/* The display mode an application set, at most the desktop's. win32u maps
+ * a smaller mode onto the desktop scaled uniformly from its top left, so
+ * frames show that part, content_width x content_height, which the title
+ * then centres on the TV as it does any frame. */
+static UINT content_width, content_height;
+static UINT32 *screen;
+static struct ps5_window windows[PS5_MAX_WINDOWS];
+static UINT window_count;
+static POINT cursor;
+/* The cursor image, straight-alpha ARGB, NULL when hidden; frame is the
+ * screen with the cursor drawn over it, what the title is given. */
+static UINT32 *cursor_image, *frame;
+static UINT cursor_width, cursor_height;
+static POINT cursor_hotspot;
+/* The cursor image's visible (non-transparent) pixels, in image coordinates */
+static RECT cursor_box;
+/* WINE_PS5_VIEW=window shows only the visible top-level windows' bounding
+ * box, which the title scales to the whole TV, instead of the desktop;
+ * view is what the last frame showed, in screen coordinates. */
+static BOOL view_windows;
+static RECT view;
+static BOOL display_published;
+static DWORD input_threads[PS5_MAX_WINDOWS];
+static UINT input_thread_count;
+
+static struct ps5_window *find_window( HWND hwnd )
+{
+    UINT i;
+    for (i = 0; i < window_count; i++) if (windows[i].hwnd == hwnd) return &windows[i];
+    return NULL;
+}
+
+/* screen_lock held */
+static void clear_screen_rect( const RECT *rect )
+{
+    RECT clip = {0, 0, screen_width, screen_height};
+    INT y;
+
+    if (!intersect_rect( &clip, &clip, rect )) return;
+    for (y = clip.top; y < clip.bottom; y++)
+        memset( screen + y * screen_width + clip.left, 0, (clip.right - clip.left) * 4 );
+}
+
+/* screen_lock held: blend the cursor into out, a width x height copy of
+ * the screen area whose top left is origin.  The pointer reaches every
+ * pixel, so at the right and bottom edges an arrow's hotspot would leave
+ * all but its tip outside the frame, and a centred hotspot would do so at
+ * every edge; the drawn cursor is moved just enough to stay whole, as a
+ * console's pointer does, while the pointer itself stays where it is. */
+static void draw_cursor( UINT32 *out, POINT origin, INT width, INT height )
+{
+    INT left = cursor.x - cursor_hotspot.x - origin.x, top = cursor.y - cursor_hotspot.y - origin.y, x, y;
+
+    left = max( min( left, width - cursor_box.right ), -cursor_box.left );
+    top = max( min( top, height - cursor_box.bottom ), -cursor_box.top );
+    for (y = max( top, 0 ); y < min( top + (INT)cursor_height, height ); y++)
+    {
+        const UINT32 *src = cursor_image + (y - top) * cursor_width;
+        UINT32 *dst = out + y * width;
+        for (x = max( left, 0 ); x < min( left + (INT)cursor_width, width ); x++)
+        {
+            UINT32 s = src[x - left], d = dst[x], a = s >> 24, blended = 0;
+            UINT shift;
+            if (!a) continue;
+            for (shift = 0; shift < 24; shift += 8)
+                blended |= ((((s >> shift) & 0xff) * a + ((d >> shift) & 0xff) * (255 - a)) / 255) << shift;
+            dst[x] = blended | 0xff000000;
+        }
+    }
+}
+
+/* screen_lock held: the part of the screen a frame shows */
+static RECT view_rect(void)
+{
+    RECT screen_rect = {0, 0, content_width, content_height}, box = {0, 0, 0, 0};
+    UINT i;
+
+    if (!view_windows) return screen_rect;
+    for (i = 0; i < window_count; i++)
+        if (windows[i].shown) union_rect( &box, &box, &windows[i].visible );
+    if (!intersect_rect( &box, &box, &screen_rect )) return screen_rect;
+    return box;
+}
+
+/* screen_lock held */
+static void present_screen(void)
+{
+    INT width, height, y;
+
+    if (!present_frame) return;
+    view = view_rect();
+    width = view.right - view.left;
+    height = view.bottom - view.top;
+    if ((!cursor_image || !frame) && width == (INT)screen_width && height == (INT)screen_height &&
+        !view.left && !view.top)
+    {
+        present_frame( screen, screen_width, screen_height, screen_width * 4 );
+        return;
+    }
+    if (!frame) return;
+    for (y = 0; y < height; y++)
+        memcpy( frame + y * width, screen + (view.top + y) * screen_width + view.left, width * 4 );
+    if (cursor_image) draw_cursor( frame, (POINT){view.left, view.top}, width, height );
+    present_frame( frame, width, height, width * 4 );
+}
