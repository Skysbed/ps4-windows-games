+/* create a connection to the in-process server and return the client end;
+ * the server end is handed to the server thread, which accepts it as a new
+ * process exactly as it would a connection on the master socket */
+int connect_inprocess_client(void)
+{
+#define SRVLOG(...) do{FILE*_l=fopen("/data/pcps4_srv.log","a"); if(_l){fprintf(_l,__VA_ARGS__);fclose(_l);}}while(0)
+    char dummy = 0;
+    struct iovec vec = { &dummy, 1 };
+    union { struct cmsghdr header; char buffer[CMSG_SPACE( sizeof(int) )]; } control;
+    struct msghdr msg;
+    struct cmsghdr *cmsg;
+    int pair[2];
+
+    if (client_channel == -1) { SRVLOG("cic: client_channel==-1\n"); return -1; }
+    if (socketpair( AF_UNIX, SOCK_STREAM, 0, pair ) == -1) { SRVLOG("cic: socketpair errno=%d\n",errno); return -1; }
+    memset( &msg, 0, sizeof(msg) );
+    memset( &control, 0, sizeof(control) );
+    msg.msg_iov = &vec;
+    msg.msg_iovlen = 1;
+    msg.msg_control = &control;
+    msg.msg_controllen = CMSG_SPACE( sizeof(int) );
+    cmsg = CMSG_FIRSTHDR( &msg );
+    cmsg->cmsg_level = SOL_SOCKET;
+    cmsg->cmsg_type = SCM_RIGHTS;
+    cmsg->cmsg_len = CMSG_LEN( sizeof(int) );
+    memcpy( CMSG_DATA( cmsg ), &pair[0], sizeof(int) );
+#ifdef __PROSPERO__
+    /* PS4 AF_UNIX rejects SCM_RIGHTS (EINVAL). Client and server share the
+     * process, so the fd number is valid in both; send it as plain data and
+     * let the server use the same descriptor (do not close it here). */
+    if (send( client_channel, &pair[0], sizeof(pair[0]), 0 ) != (ssize_t)sizeof(pair[0]))
+    {
+        SRVLOG("cic: send(raw fd) errno=%d\n",errno);
+        close( pair[0] ); close( pair[1] ); return -1;
+    }
+    return pair[1];
+#else
+    { int _sr=sendmsg( client_channel, &msg, 0 );
+      if (_sr != 1)
+    {
+        close( pair[0] );
+        close( pair[1] );
+        return -1;
+    } }
+    close( pair[0] );
+    return pair[1];
+#endif
+}
