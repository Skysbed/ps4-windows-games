+        fd->obj.refcount <= 1 || view_refs != fd->obj.refcount - 1 ||
+        fd->unix_fd == -1 || fd->access != (FILE_MAPPING_ACCESS | FILE_MAPPING_IMAGE) ||
+        fd->user || !fd->inode || !fd->closed ||
+        fd->closed->unix_fd != fd->unix_fd || fd->closed->disp_flags ||
+        (fd->options & FILE_DELETE_ON_CLOSE) || !list_empty( &fd->locks ) ||
+        !list_empty( &fd->inode->locks ) || !list_empty( &fd->inode->closed ) ||
+        async_queued( &fd->read_q ) || async_queued( &fd->write_q ) ||
