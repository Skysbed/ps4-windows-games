diff --git a/src/vk_ps4_desc_tables.c b/src/vk_ps4_desc_tables.c
new file mode 100644
index 0000000..7ebf3da
--- /dev/null
+++ b/src/vk_ps4_desc_tables.c
@@ -0,0 +1,171 @@
+/*
+ * Descriptor sets in the layout the compiled shaders expect.
+ *
+ * libpsbc compiles every descriptor access (uniform buffer, texture, sampler) into scalar loads
+ * from a descriptor-set pointer held in a user-data register: s_load of a V#/T#/S# from
+ * (set address + binding offset). The offsets come from the pipeline layout the shader was
+ * compiled against (see vk_ps4_compile_shader_module). This file computes that byte layout,
+ * mirrors a VkDescriptorSet's descriptors into GPU-visible memory at those offsets, and writes
+ * the set address into the user-data register of every stage that reads it.
+ */
+#include "vk_ps4_internal.h"
+#include <string.h>
+#include <pm4/sid.h>
+#include <pm4/amdgfxregs.h>
+
+#define VK_PS4_MAX_BOUND_SETS 8
+
+uint32_t vk_ps4_desc_elem_size(VkDescriptorType t) {
+    switch (t) {
+    case VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER:
+        return 96; /* T# at +0 (32 bytes), S# at +64 */
+    case VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE:
+    case VK_DESCRIPTOR_TYPE_STORAGE_IMAGE:
+    case VK_DESCRIPTOR_TYPE_INPUT_ATTACHMENT:
+        return 64; /* T# at +0 (32 bytes), room for the FMASK plane */
+    default:
+        return 16; /* V# / S# */
+    }
+}
+
+/* Offsets/sizes per layout binding (indexed like layout->bindings), packed in ascending binding
+ * number order, each binding 32-byte aligned. */
+void vk_ps4_layout_compute(const VkPs4DescriptorSetLayout *l, uint32_t *offsets, uint32_t *sizes,
+                           uint32_t *total) {
+    uint32_t n = l ? l->binding_count : 0;
+    uint32_t cur = 0;
+    bool done[VK_PS4_MAX_DESCRIPTOR_BINDINGS] = {0};
+    if (n > VK_PS4_MAX_DESCRIPTOR_BINDINGS) n = VK_PS4_MAX_DESCRIPTOR_BINDINGS;
+    for (uint32_t k = 0; k < n; k++) {
+        int best = -1;
+        for (uint32_t i = 0; i < n; i++) {
+            if (done[i]) continue;
+            if (best < 0 || l->bindings[i].binding < l->bindings[best].binding) best = (int)i;
+        }
+        if (best < 0) break;
+        done[best] = true;
+        uint32_t sz = vk_ps4_desc_elem_size(l->bindings[best].descriptorType);
+        cur = (cur + 31u) & ~31u;
+        offsets[best] = cur;
+        sizes[best] = sz;
+        cur += sz * (l->bindings[best].descriptorCount ? l->bindings[best].descriptorCount : 1);
+    }
+    if (total) *total = (cur + 31u) & ~31u;
+}
+
+static bool is_dynamic_type(VkDescriptorType t) {
+    return t == VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC || t == VK_DESCRIPTOR_TYPE_STORAGE_BUFFER_DYNAMIC;
+}
+
+/* Copy a set's descriptors into GPU-visible memory. Dynamic offsets (consumed in ascending binding
+ * order, one per array element) are folded into the buffer descriptors' base addresses. */
+void vk_ps4_flush_set(VkPs4DescriptorSet *set, const uint32_t **dyn, uint32_t *dyn_left) {
+    if (!set || !set->layout) return;
+    uint32_t offsets[VK_PS4_MAX_DESCRIPTOR_BINDINGS] = {0};
+    uint32_t sizes[VK_PS4_MAX_DESCRIPTOR_BINDINGS] = {0};
+    uint32_t total = 0;
+    vk_ps4_layout_compute(set->layout, offsets, sizes, &total);
+    if (total == 0) total = 32;
+    if (!set->gpu_mem || set->gpu_size < total) {
+        VkPs4Device *dev = set->device;
+        uint32_t want = total < 256 ? 256 : total;
+        uint8_t *mem = (uint8_t *)vk_ps4_alloc(dev ? &dev->allocator : NULL, want, 256);
+        if (!mem) return;
+        if (set->gpu_mem) vk_ps4_free(dev ? &dev->allocator : NULL, set->gpu_mem);
+        set->gpu_mem = mem;
+        set->gpu_size = want;
+    }
+    memset(set->gpu_mem, 0, set->gpu_size);
+
+    /* Dynamic offsets are consumed in ascending binding order. */
+    const VkPs4DescriptorSetLayout *l = set->layout;
+    uint32_t lcount = l->binding_count < VK_PS4_MAX_DESCRIPTOR_BINDINGS ? l->binding_count : VK_PS4_MAX_DESCRIPTOR_BINDINGS;
+    uint32_t order[VK_PS4_MAX_DESCRIPTOR_BINDINGS];
+    for (uint32_t i = 0; i < lcount; i++) order[i] = i;
+    for (uint32_t i = 0; i < lcount; i++)
+        for (uint32_t j = i + 1; j < lcount; j++)
+            if (l->bindings[order[j]].binding < l->bindings[order[i]].binding) {
+                uint32_t t = order[i]; order[i] = order[j]; order[j] = t;
+            }
+
+    for (uint32_t oi = 0; oi < lcount; oi++) {
+        uint32_t li = order[oi];
+        const VkDescriptorSetLayoutBinding *lb = &l->bindings[li];
+        VkPs4DescriptorBinding *b = NULL;
+        for (uint32_t i = 0; i < set->binding_count; i++)
+            if (set->bindings[i].binding_number == lb->binding) { b = &set->bindings[i]; break; }
+        uint32_t count = b ? b->count : 0;
+        bool dynamic = is_dynamic_type(lb->descriptorType);
+        for (uint32_t e = 0; e < count; e++) {
+            uint32_t dyn_off = 0;
+            if (dynamic && dyn && *dyn && dyn_left && *dyn_left) {
+                dyn_off = **dyn;
+                (*dyn)++;
+                (*dyn_left)--;
+            }
+            uint8_t *dst = set->gpu_mem + offsets[li] + e * sizes[li];
+            switch (lb->descriptorType) {
+            case VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER:
+            case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER:
+            case VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC:
+            case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER_DYNAMIC:
+            case VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER:
+            case VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER:
+                if (b->buffers) {
+                    GnmBuffer v = b->buffers[e];
+                    if (dyn_off) sceGnmBufSetBaseAddress(&v, (char *)sceGnmBufGetBaseAddress(&v) + dyn_off);
+                    memcpy(dst, &v, sizeof(GnmBuffer));
+                }
+                break;
+            case VK_DESCRIPTOR_TYPE_SAMPLER:
+                if (b->samplers) memcpy(dst, &b->samplers[e], sizeof(GnmSampler));
+                break;
+            case VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE:
+            case VK_DESCRIPTOR_TYPE_STORAGE_IMAGE:
+            case VK_DESCRIPTOR_TYPE_INPUT_ATTACHMENT:
+                if (b->textures) memcpy(dst, &b->textures[e], sizeof(GnmTexture));
+                break;
+            case VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER:
+                if (b->textures) memcpy(dst, &b->textures[e], sizeof(GnmTexture));
+                if (b->samplers) memcpy(dst + 64, &b->samplers[e], sizeof(GnmSampler));
+                break;
+            default:
+                break;
+            }
+        }
+    }
+#if defined(__x86_64__)
+    __asm__ volatile("sfence" ::: "memory");
+#endif
+}
+
+static void emit_user_data_dword(GnmCommandBuffer *gc, uint32_t reg_base, bool is_cs, uint32_t reg, uint32_t value) {
+    if ((uint32_t)(gc->endptr - gc->cmdptr) < 3 && gc->callback.func)
+        gc->callback.func(gc, 3, gc->callback.userdata);
+    if ((uint32_t)(gc->endptr - gc->cmdptr) < 3) return;
+    gc->cmdptr[0] = PKT3(PKT3_SET_SH_REG, 1, 0) | (is_cs ? PKT3_SHADER_TYPE_S(1) : 0);
+    gc->cmdptr[1] = (reg_base + reg * 4 - SI_SH_REG_OFFSET) >> 2;
+    gc->cmdptr[2] = value;
+    gc->cmdptr += 3;
+}
+
+static void emit_stage(VkPs4CommandBuffer *cmd, const GnmInputUsageSlot *slots, uint32_t count,
+                       uint32_t reg_base, bool is_cs) {
+    for (uint32_t i = 0; i < count; i++) {
+        if (slots[i].usagetype != GNM_SHINPUTUSAGE_PTR_INDIRECTRESOURCETABLE) continue;
+        uint32_t set = slots[i].apislot;
+        if (set >= VK_PS4_MAX_BOUND_SETS) continue;
+        VkPs4DescriptorSet *s = cmd->bound_sets[set];
+        if (!s || !s->gpu_mem) continue;
+        emit_user_data_dword(&cmd->gnm_cmd, reg_base, is_cs, slots[i].startregister,
+                             (uint32_t)(uintptr_t)s->gpu_mem);
+    }
+}
+
+/* Write the address of each bound set into the user-data registers the pipeline's shaders use. */
+void vk_ps4_emit_set_tables(VkPs4CommandBuffer *cmd, const VkPs4Pipeline *pipe) {
+    if (!cmd || !pipe) return;
+    if (pipe->bind_point != VK_PIPELINE_BIND_POINT_GRAPHICS) return; /* compute: not yet */
+    emit_stage(cmd, pipe->vs_input_usage_slots, pipe->vs_input_usage_slot_count, R_00B130_SPI_SHADER_USER_DATA_VS_0, false);
+    emit_stage(cmd, pipe->ps_input_usage_slots, pipe->ps_input_usage_slot_count, R_00B030_SPI_SHADER_USER_DATA_PS_0, false);
+}
