+ */
+
+#ifndef __WINE_XINPUT_UNIXLIB_H
+#define __WINE_XINPUT_UNIXLIB_H
+
+#include "wine/unixlib.h"
+
+/* The layout of PwWinePad in the title's sink. It holds no pointers, so
+ * both sides of WoW64 read it alike and the 32-bit calls need no thunks. */
+struct xinput_pad_state
+{
+    UINT32 connected;
+    UINT32 packet;
+    UINT16 buttons;
+    BYTE left_trigger;
+    BYTE right_trigger;
+    INT16 thumb_lx;
+    INT16 thumb_ly;
+    INT16 thumb_rx;
+    INT16 thumb_ry;
+};
+
+struct xinput_rumble_params
+{
+    UINT32 left;
+    UINT32 right;
+};
+
+enum xinput_unix_funcs
+{
+    unix_pad_init,
+    unix_pad_state,
+    unix_pad_rumble,
+    unix_funcs_count,
+};
+
+#endif /* __WINE_XINPUT_UNIXLIB_H */
