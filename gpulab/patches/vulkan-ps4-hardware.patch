+/* PcPs4 hardware patch: the compiled shader file stores code unrelocated. The
+ * GPU fetches instructions from the address in the stage registers, so copy the
+ * code into GPU-visible memory and point the registers at it (the same step the
+ * vendor's loadvshader/loadpshader performs). */
+static void *pcps4_place_shader_code(const VkAllocationCallbacks *alloc,
+                                     const GnmShaderMetadata *md) {
+    if (!md || !md->shadercode || md->shadercodesize == 0) return NULL;
+    void *dst = vk_ps4_alloc(alloc, md->shadercodesize, 256);
+    if (!dst) return NULL;
+    memcpy(dst, md->shadercode, md->shadercodesize);
+    return dst;
+}
