+/* Diagnostic only: preserve the ordinary syscall dispatch and its result.
+ * Counts belong to this thread and cover guest 32-bit system-service entries,
+ * including calls that can be satisfied without a host syscall. */
+struct pw_syscall_histogram
+{
+    ULONGLONG counts[0x4000], reported[0x4000], total;
+    ULONG callers[64];
+    ULONGLONG caller_counts[64], caller_other;
+};
+static RTL_RUN_ONCE pw_syscall_once = RTL_RUN_ONCE_INIT;
+static struct { void *teb; struct pw_syscall_histogram *data; } pw_syscall_slots[64];
+static BOOL pw_syscall_enabled;
