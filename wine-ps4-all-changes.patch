+/* PS4: the host reports no network adapters, but .NET refuses to run without
+ * at least one.  Hand out a synthetic Ethernet adapter instead of ERROR_NO_DATA. */
+static ULONG fake_adapter_size(void)
+{
+    return sizeof(IP_ADAPTER_ADDRESSES) + 64 + 4 * 64 * sizeof(WCHAR);
+}
+
+static void fake_adapter_fill( IP_ADAPTER_ADDRESSES *aa )
+{
+    WCHAR *w = (WCHAR *)((char *)(aa + 1) + 64);
+
+    memset( aa, 0, fake_adapter_size() );
+    aa->Length = sizeof(*aa);
+    aa->IfIndex = 1;
+    aa->IfType = 6; /* IF_TYPE_ETHERNET_CSMACD */
+    aa->OperStatus = 1; /* IfOperStatusUp */
+    aa->Ipv6IfIndex = 1;
+    aa->AdapterName = (char *)(aa + 1);
+    strcpy( aa->AdapterName, "{00000000-0000-0000-0000-000000000001}" );
+    aa->Description = w; wcscpy( w, L"Ethernet" ); w += 16;
+    aa->DnsSuffix = w; wcscpy( w, L"" ); w += 2;
+    aa->FriendlyName = w; wcscpy( w, L"Ethernet" );
+    aa->PhysicalAddressLength = 6;
+    memset( aa->PhysicalAddress, 0x02, 6 );
+}
+
 ULONG WINAPI DECLSPEC_HOTPATCH GetAdaptersAddresses( ULONG family, ULONG flags, void *reserved,
                                                      IP_ADAPTER_ADDRESSES *aa, ULONG *size )
 {
@@ -1337,6 +1364,17 @@ ULONG WINAPI DECLSPEC_HOTPATCH GetAdaptersAddresses( ULONG family, ULONG flags,
     if (!size) return ERROR_INVALID_PARAMETER;
 
     err = adapters_addresses_alloc( family, flags, &info, &count );
+    if (err) /* PS4: NSI reports no adapters at all */
+    {
+        needed = fake_adapter_size();
+        if (!aa || *size < needed)
+        {
+            *size = needed;
+            return ERROR_BUFFER_OVERFLOW;
+        }
+        fake_adapter_fill( aa );
+        return 0;
+    }
     if (err) return err;
 
     needed = adapters_addresses_size( info );
