+#ifdef __ORBIS__
+#include <fcntl.h>
+#include <sys/stat.h>
+/***********************************************************************
+ * PCPS4: kernel-level signal handlers and the freeze report
+ *
+ * After WinePS4 (iHaiDeeZ/WinePS4, LGPL-2.1): port/ps4_wine_port.c's raw sigaction and hang.log.
+ *
+ * - PCPS4_RAW_SIGACTION=1 in /data/pcps4_env.txt: Wine's handlers are installed with the kernel's
+ *   sigaction (system call 416) instead of the PS4 thread library's, whose wrapper holds a signal back
+ *   while the thread is inside the library's own locks (a suspend request that never arrives).
+ * - The freeze report: /data/pcps4/hang.log gets every Wine thread's position (its Unix rip and, inside
+ *   a system call, the Windows rip/rsp it came from), the code addresses on its stacks, and the PE and
+ *   PS4 modules with their ranges. Written when /data/pcps4_hangdump appears (the file is removed), and
+ *   once PCPS4_HANG_DUMP=<seconds> after the start. The signal (SIGXCPU) is always installed through the
+ *   kernel, and nothing in the report takes a lock a stuck thread may hold: no stdio, no malloc.
+ */
+extern int32_t sceKernelQueryMemoryProtection( void *, void **, void **, int32_t * );
+extern int32_t sceKernelGetModuleList( uint32_t *array, size_t size, size_t *available );
+extern int32_t sceKernelGetModuleInfo( uint32_t handle, void *info );
+
+static long pcps4_sys3( long number, long a, long b, long c )
+{
+    long ret;
+    unsigned char failed;
+
+    __asm__ volatile( "syscall\n\tsetc %1"
+                      : "=a" (ret), "=qm" (failed)
+                      : "a" (number), "D" (a), "S" (b), "d" (c)
+                      : "rcx", "r8", "r9", "r10", "r11", "memory", "cc" );
+    return failed ? -1 : ret;
+}
+
+/* First observations stay available even if a later thread stalls mid-handshake. */
+#define PCPS4_OBSERVATIONS 256
+struct pcps4_observation
+{
+    long kernel_tid, request_tid;
+    ULONG64 rip, rsp;
+    const char *phase;
+};
+static struct pcps4_observation pcps4_handshakes[PCPS4_OBSERVATIONS], pcps4_suspends[PCPS4_OBSERVATIONS];
+static unsigned int pcps4_handshake_count, pcps4_suspend_count;
+_Static_assert( __atomic_always_lock_free( sizeof(unsigned int), 0 ) &&
+                __atomic_always_lock_free( sizeof(void *), 0 ), "signal observations require lock-free atomics" );
+
+static struct pcps4_observation *pcps4_record( struct pcps4_observation *records, unsigned int *count,
+                                               long request_tid, ULONG64 rip, ULONG64 rsp, const char *phase )
+{
+    unsigned int i;
+    long tid = -1;
+
+    if (__atomic_load_n( count, __ATOMIC_RELAXED ) >= PCPS4_OBSERVATIONS) return NULL;
+    i = __atomic_fetch_add( count, 1, __ATOMIC_RELAXED );
+    if (i >= PCPS4_OBSERVATIONS) return NULL;
+    if (pcps4_sys3( 432 /* SYS_thr_self */, (long)&tid, 0, 0 ) == -1) tid = -1;
+    records[i].kernel_tid = tid;
+    records[i].request_tid = request_tid;
+    records[i].rip = rip;
+    records[i].rsp = rsp;
+    __atomic_store_n( &records[i].phase, phase, __ATOMIC_RELEASE );
+    return &records[i];
+}
+
+void pcps4_observe_handshake( int request_tid, const char *phase )
+{
+    pcps4_record( pcps4_handshakes, &pcps4_handshake_count, request_tid, 0, 0, phase );
+}
+
+static struct pcps4_observation *pcps4_suspend_enter( ULONG64 rip, ULONG64 rsp )
+{
+    return pcps4_record( pcps4_suspends, &pcps4_suspend_count, 0, rip, rsp, "entered" );
+}
+
+static void pcps4_suspend_phase( struct pcps4_observation *record, const char *phase )
+{
+    if (record) __atomic_store_n( &record->phase, phase, __ATOMIC_RELEASE );
+}
+
+/* <name>=<number> from the launch's env file (the tile's env lines), else def */
+static int pcps4_env_int( const char *name, int def )
+{
+    char buf[8192];
+    size_t len = strlen( name );
+    int fd = pcps4_sys3( 5 /* SYS_open */, (long)"/data/pcps4_env.txt", 0, 0 ), n, value = def;
+    char *line, *next;
+
+    if (fd == -1) return def;
+    n = pcps4_sys3( 3 /* SYS_read */, fd, (long)buf, sizeof(buf) - 1 );
+    pcps4_sys3( 6 /* SYS_close */, fd, 0, 0 );
+    if (n <= 0) return def;
+    buf[n] = 0;
+    for (line = buf; line && *line; line = next)
+    {
+        if ((next = strchr( line, '\n' ))) *next++ = 0;
+        if (!strncmp( line, name, len ) && line[len] == '=') value = atoi( line + len + 1 );
+    }
+    return value;
+}
+
+static int pcps4_raw_sig = -1;
+
+static int pcps4_orbis_sigaction( int signal, const struct sigaction *action, struct sigaction *previous )
+{
+    if (pcps4_raw_sig < 0)
+    {
+        pcps4_raw_sig = pcps4_env_int( "PCPS4_RAW_SIGACTION", 0 ) == 1;
+        if (pcps4_raw_sig) fprintf( stderr, "pcps4: signal handlers through the kernel's sigaction\n" );
+    }
+    if (pcps4_raw_sig)
+    {
+        if (pcps4_sys3( 416 /* SYS_sigaction */, signal, (long)action, (long)previous ) != -1) return 0;
+        fprintf( stderr, "pcps4: kernel sigaction %d refused, the thread library's instead\n", signal );
+    }
+    return sigaction( signal, action, previous );
+}
+
+#define PCPS4_MAX_THREADS 512
+static struct { long tid; struct thread_data *data; } pcps4_threads[PCPS4_MAX_THREADS];
+static volatile int pcps4_dump_done;
+static volatile ULONG64 pcps4_dump_rip, pcps4_dump_rsp;
+static TEB *pcps4_main_teb;
+
+void pcps4_hang_register( struct thread_data *data )
+{
+    long tid = 0, old;
+    int i;
+
+    if (pcps4_sys3( 432 /* SYS_thr_self */, (long)&tid, 0, 0 ) == -1 || tid <= 0) return;
+    for (i = 0; i < PCPS4_MAX_THREADS; i++)
+    {
+        old = __atomic_load_n( &pcps4_threads[i].tid, __ATOMIC_ACQUIRE );
+        if (old < 0) continue;  /* being claimed */
+        if (old && pcps4_sys3( 433 /* SYS_thr_kill */, old, 0, 0 ) != -1) continue;  /* alive */
+        if (!__atomic_compare_exchange_n( &pcps4_threads[i].tid, &old, -1, 0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE ))
+            continue;
+        pcps4_threads[i].data = data;
+        __atomic_store_n( &pcps4_threads[i].tid, tid, __ATOMIC_RELEASE );
+        return;
+    }
+}
+
+static void pcps4_dump_handler( int signal, siginfo_t *siginfo, void *sigcontext )
+{
+    ucontext_t *context = sigcontext;
+
+    pcps4_dump_rip = RIP_sig( context );
+    pcps4_dump_rsp = RSP_sig( context );
+    __atomic_store_n( &pcps4_dump_done, 1, __ATOMIC_RELEASE );
+}
+
+struct pcps4_line { char text[4096]; int len; };
+
+static void pcps4_put( struct pcps4_line *l, const char *s )
+{
+    while (*s && l->len < (int)sizeof(l->text) - 1) l->text[l->len++] = *s++;
+}
+
+static void pcps4_hex( struct pcps4_line *l, ULONG64 v )
+{
+    char b[24];
+    int i = 0, n = 0;
+
+    b[i++] = '0'; b[i++] = 'x';
+    do { n++; } while (n < 16 && v >> (4 * n));
+    while (n--) b[i++] = "0123456789abcdef"[(v >> (4 * n)) & 15];
+    b[i] = 0;
+    pcps4_put( l, b );
+}
+
+static void pcps4_dec( struct pcps4_line *l, ULONG64 v )
+{
+    char b[24];
+    int i = 23;
+
+    b[i] = 0;
+    do { b[--i] = '0' + v % 10; v /= 10; } while (v);
+    pcps4_put( l, b + i );
+}
+
+static void pcps4_flush( int fd, struct pcps4_line *l )
+{
+    if (l->len) pcps4_sys3( 4 /* SYS_write */, fd, (long)l->text, l->len );
+    l->len = 0;
+}
+
+static struct { ULONG64 start, end; int exec; } pcps4_regions[512];
+static int pcps4_nregions;
+
+static int pcps4_region( ULONG64 v, ULONG64 *end )
+{
+    void *s, *e;
+    int32_t prot;
+    int i;
+
+    for (i = 0; i < pcps4_nregions; i++)
+        if (v >= pcps4_regions[i].start && v < pcps4_regions[i].end)
+        {
+            if (end) *end = pcps4_regions[i].end;
+            return pcps4_regions[i].exec;
+        }
+    if (sceKernelQueryMemoryProtection( (void *)v, &s, &e, &prot )) return -1;
+    if (v < (ULONG64)s || v >= (ULONG64)e) return -1;
+    if (pcps4_nregions < 512)
+    {
+        pcps4_regions[pcps4_nregions].start = (ULONG64)s;
+        pcps4_regions[pcps4_nregions].end = (ULONG64)e;
+        pcps4_regions[pcps4_nregions].exec = (prot & 4) != 0;
+        pcps4_nregions++;
+    }
+    if (end) *end = (ULONG64)e;
+    return (prot & 4) != 0;
+}
+
+/* the code addresses between sp and top (at most 32 KiB, never past sp's mapping) */
+static void pcps4_scan( int fd, struct pcps4_line *l, const char *what, ULONG64 sp, ULONG64 top )
+{
+    ULONG64 end, *p;
+    int n = 0;
+
+    sp &= ~7ull;
+    if (pcps4_region( sp, &end ) < 0) return;
+    if (!top || top > end) top = end;
+    if (top > sp + 0x8000) top = sp + 0x8000;
+    pcps4_put( l, "   " );
+    pcps4_put( l, what );
+    pcps4_put( l, ":" );
+    for (p = (ULONG64 *)sp; (ULONG64)p < top && n < 48; p++)
+    {
+        ULONG64 v = *p;
+        if (v < 0x10000 || v >= 0x800000000000ull) continue;
+        if (pcps4_region( v, NULL ) != 1) continue;
+        pcps4_put( l, " " );
+        pcps4_hex( l, v );
+        n++;
+        if (l->len > (int)sizeof(l->text) - 64) pcps4_flush( fd, l );
+    }
+    pcps4_put( l, "\n" );
+    pcps4_flush( fd, l );
+}
+
+static void pcps4_dump_modules( int fd, struct pcps4_line *l )
+{
+    uint32_t handles[256];
+    size_t count = 0, i;
+    int n = 0;
+
+    /* the PE modules, from the loader's list (read without its lock: the process is stuck) */
+    if (pcps4_main_teb && pcps4_main_teb->Peb && pcps4_main_teb->Peb->LdrData)
+    {
+        LIST_ENTRY *head = &pcps4_main_teb->Peb->LdrData->InLoadOrderModuleList, *e;
+
+        for (e = head->Flink; e && e != head && n < 400; e = e->Flink, n++)
+        {
+            LDR_DATA_TABLE_ENTRY *mod = CONTAINING_RECORD( e, LDR_DATA_TABLE_ENTRY, InLoadOrderLinks );
+            char name[128];
+            int j, len = mod->BaseDllName.Length / sizeof(WCHAR);
+
+            for (j = 0; j < len && j < 127; j++) name[j] = mod->BaseDllName.Buffer[j] < 0x80 ? mod->BaseDllName.Buffer[j] : '?';
+            name[j] = 0;
+            pcps4_put( l, "pe " );
+            pcps4_hex( l, (ULONG64)mod->DllBase );
+            pcps4_put( l, " " );
+            pcps4_hex( l, (ULONG64)mod->SizeOfImage );
+            pcps4_put( l, " " );
+            pcps4_put( l, name );
+            pcps4_put( l, "\n" );
+            pcps4_flush( fd, l );
+        }
+    }
+    /* the PS4 modules (the .prx files) and their segments */
+    if (!sceKernelGetModuleList( handles, 256, &count ))
+        for (i = 0; i < count && i < 256; i++)
+        {
+            struct { size_t size; char name[256]; struct { void *address; uint32_t size; int32_t prot; } seg[4];
+                     uint32_t count; uint8_t fingerprint[20]; } info;
+            uint32_t s;
+
+            memset( &info, 0, sizeof(info) );
+            info.size = sizeof(info);
+            if (sceKernelGetModuleInfo( handles[i], &info )) continue;
+            info.name[255] = 0;
+            for (s = 0; s < info.count && s < 4; s++)
+            {
+                pcps4_put( l, "prx " );
+                pcps4_hex( l, (ULONG64)info.seg[s].address );
+                pcps4_put( l, " " );
+                pcps4_hex( l, info.seg[s].size );
+                pcps4_put( l, " " );
+                pcps4_put( l, info.name );
+                pcps4_put( l, " prot " );
+                pcps4_dec( l, info.seg[s].prot );
+                pcps4_put( l, "\n" );
+                pcps4_flush( fd, l );
+            }
+        }
+}
+
+static void pcps4_dump_observations( int fd, struct pcps4_line *l, struct pcps4_observation *records )
+{
+    unsigned int i;
+    for (i = 0; i < PCPS4_OBSERVATIONS; i++)
+    {
+        const char *phase = __atomic_load_n( &records[i].phase, __ATOMIC_ACQUIRE );
+        if (!phase) continue;
+        pcps4_put( l, phase );
+        if (records == pcps4_handshakes)
+        {
+            pcps4_put( l, " req.unix_tid=" );
+            pcps4_hex( l, records[i].request_tid );
+            pcps4_put( l, records[i].kernel_tid < 0 ? " raw_failed" :
+                       records[i].kernel_tid == records[i].request_tid ? " match" : " mismatch" );
+        }
+        else
+        {
+            pcps4_put( l, " SIGUSR1 rip=" );
+            pcps4_hex( l, records[i].rip );
+            pcps4_put( l, " rsp=" );
+            pcps4_hex( l, records[i].rsp );
+        }
+        pcps4_put( l, " raw_thr_self=" );
+        pcps4_hex( l, records[i].kernel_tid );
+        pcps4_put( l, "\n" );
+        pcps4_flush( fd, l );
+    }
+}
+
+static int pcps4_can_sample;
+
+static int pcps4_dump_threads( const char *reason )
+{
+    static const struct { long sec, nsec; } tick = { 0, 1000000 };
+    struct pcps4_line l;
+    int fd, i, waited;
+
+    /* FreeBSD kernel flags for WRONLY | APPEND | CREAT. */
+    fd = pcps4_sys3( 5, (long)"/data/pcps4/hang.log", 0x209, 0666 );
+    if (fd == -1) return 0;
+    l.len = 0;
+    pcps4_put( &l, "==== " );
+    pcps4_put( &l, reason );
+    pcps4_put( &l, pcps4_raw_sig == 1 ? " (kernel sigaction)\n" : " (thread library sigaction)\n" );
+    pcps4_flush( fd, &l );
+    pcps4_dump_observations( fd, &l, pcps4_handshakes );
+    pcps4_dump_observations( fd, &l, pcps4_suspends );
+    pcps4_nregions = 0;
+    for (i = 0; i < PCPS4_MAX_THREADS; i++)
+    {
+        long tid = __atomic_load_n( &pcps4_threads[i].tid, __ATOMIC_ACQUIRE );
+        struct thread_data *data = pcps4_threads[i].data;
+        ULONG64 rip, rsp;
+
+        if (!pcps4_can_sample) break;
+        if (tid <= 0 || !data) continue;
+        __atomic_store_n( &pcps4_dump_done, 0, __ATOMIC_RELEASE );
+        if (pcps4_sys3( 433 /* SYS_thr_kill */, tid, SIGXCPU, 0 ) == -1) continue;  /* ended */
+        for (waited = 0; waited < 200 && !__atomic_load_n( &pcps4_dump_done, __ATOMIC_ACQUIRE ); waited++)
+            pcps4_sys3( 240 /* SYS_nanosleep */, (long)&tick, 0, 0 );
+        pcps4_put( &l, "-- thread " );
+        pcps4_hex( &l, data->tid );
+        pcps4_put( &l, " (kernel " );
+        pcps4_dec( &l, tid );
+        pcps4_put( &l, ")" );
+        if (!__atomic_load_n( &pcps4_dump_done, __ATOMIC_ACQUIRE ))
+        {
+            /* the signal is held back or the thread can't run: still say where its last call came from */
+            pcps4_put( &l, ": no answer" );
+            rip = rsp = 0;
+        }
+        else
+        {
+            rip = pcps4_dump_rip;
+            rsp = pcps4_dump_rsp;
+            pcps4_put( &l, ": rip " );
+            pcps4_hex( &l, rip );
+            pcps4_put( &l, " rsp " );
+            pcps4_hex( &l, rsp );
+        }
+        if (data->teb && get_syscall_frame( data ) && (!rsp || is_inside_syscall( data, rsp )))
+        {
+            struct syscall_frame *frame = get_syscall_frame( data );
+            pcps4_put( &l, rsp ? ", in a system call from PE rip " : ", last system call from PE rip " );
+            pcps4_hex( &l, frame->rip );
+            pcps4_put( &l, " rsp " );
+            pcps4_hex( &l, frame->rsp );
+            pcps4_put( &l, "\n" );
+            pcps4_flush( fd, &l );
+            if (rsp) pcps4_scan( fd, &l, "unix stack", rsp, (ULONG64)frame );
+            pcps4_scan( fd, &l, "pe stack", frame->rsp, (ULONG64)data->teb->Tib.StackBase );
+        }
+        else
+        {
+            pcps4_put( &l, "\n" );
+            pcps4_flush( fd, &l );
+            if (rsp) pcps4_scan( fd, &l, "stack", rsp, data->teb ? (ULONG64)data->teb->Tib.StackBase : 0 );
+        }
+    }
+    pcps4_dump_modules( fd, &l );
+    pcps4_sys3( 6 /* SYS_close */, fd, 0, 0 );
+    return 1;
+}
+
+extern uint64_t sceKernelGetProcessTime( void );
+extern int32_t sceKernelUsleep( uint32_t );
+
+static void *pcps4_hang_watch( void *arg )
+{
+    int seconds = (int)(long)arg;
+    uint64_t deadline = seconds > 0 ? sceKernelGetProcessTime() + (uint64_t)seconds * 1000000 : 0;
+    sigset_t set;
+
+    sigfillset( &set );
+    pthread_sigmask( SIG_BLOCK, &set, NULL );
+    for (;;)
+    {
+        sceKernelUsleep( 1000000 );
+        if (deadline && sceKernelGetProcessTime() >= deadline && pcps4_dump_threads( "timed" ))
+            deadline = 0;
+        if (pcps4_sys3( 10 /* SYS_unlink */, (long)"/data/pcps4_hangdump", 0, 0 ) != -1)
+            pcps4_dump_threads( "requested" );
+    }
+    return NULL;
+}
+
+static void pcps4_hang_init( TEB *teb )
+{
+    struct sigaction sa;
+    pthread_t thread;
+
+    pcps4_main_teb = teb;
+    memset( &sa, 0, sizeof(sa) );
+    sa.sa_sigaction = pcps4_dump_handler;
+    sa.sa_flags = SA_SIGINFO | SA_RESTART | SA_ONSTACK;
+    sigfillset( &sa.sa_mask );
+    pcps4_can_sample = pcps4_sys3( 416 /* SYS_sigaction */, SIGXCPU, (long)&sa, 0 ) != -1 ||
+                       sigaction( SIGXCPU, &sa, NULL ) != -1;
+    pcps4_hang_register( get_thread_data() );
+    if (!pthread_create( &thread, NULL, pcps4_hang_watch, (void *)(long)pcps4_env_int( "PCPS4_HANG_DUMP", 0 ) ))
+        pthread_detach( thread );
