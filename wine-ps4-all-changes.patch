+/* Take the server lock. Another client thread holds it for a microsecond or
+ * two, so spin briefly before sleeping, which costs a thread switch. */
+static void lock_server_for_client(void)
+{
+    int i;
+
+    for (i = 0; i < 200; i++)
+    {
+        if (!pthread_mutex_trylock( &inprocess_server_mutex )) return;
+#if defined(__i386__) || defined(__x86_64__)
+        __asm__ __volatile__( "pause" );
+#endif
+    }
+    pthread_mutex_lock( &inprocess_server_mutex );
 }
 
+/* Run a request on the calling thread, which is the client thread tid of
+ * this process, instead of sending it to the server thread through the
+ * request pipe and waiting for the reply pipe: two thread switches (about
+ * 20 us on the PS5) become a lock. The server thread holds the lock except
+ * while it sleeps. Returns 0 with the reply in info, 1 when the request must
+ * go through the pipe instead, 2 when the server killed the thread (the
+ * pipe would have been closed). */
+DECLSPEC_EXPORT int pw_wineserver_call_direct( unsigned int tid, client_ptr_t teb,
+                                               struct __server_request_info *info )
+{
+    enum request req = info->u.req.request_header.req;
+    data_size_t size = info->u.req.request_header.request_size, pos = 0;
+    union generic_reply reply;
+    struct thread *thread;
+    char data[4096];
+    unsigned int i;
+    int ret = 1;
+
+    if (!__atomic_load_n( &inprocess_direct_ok, __ATOMIC_ACQUIRE ) || !is_direct_request( req ) || size > sizeof(data)) return 1;
+    for (i = 0; i < info->data_count && i < __SERVER_MAX_DATA; i++)
+    {
+        if (info->data[i].size > size - pos) return 1;
+        memcpy( data + pos, info->data[i].ptr, info->data[i].size );
+        pos += info->data[i].size;
+    }
+    if (pos != size) return 1;
+
+    lock_server_for_client();
+    if (!__atomic_load_n( &inprocess_direct_ok, __ATOMIC_ACQUIRE ) || !(thread = get_thread_from_id( tid )))
+    {
+        ps5_mutex_server_reconcile();
+        pthread_mutex_unlock( &inprocess_server_mutex );
+        return 1;
+    }
+    /* a thread the server has not initialised, or has already killed, uses
+     * the pipe, which reports its death exactly as before */
+    if (thread->teb == teb && teb && thread->state != TERMINATED && thread->reply_fd &&
+        !thread->req_toread && !thread->reply_towrite && !thread->req_data)
+    {
+        set_current_time();
+        thread->req = info->u.req;
+        thread->req_data = size ? data : NULL;
+
+        current = thread;
+        current->ps5_last_req = req;
+        current->ps5_last_req_time = monotonic_time;
+        current->reply_size = 0;
+        clear_error();
+        memset( &reply, 0, sizeof(reply) );
+        if (debug_level) trace_request();
+
+        ps5_mutex_server_begin();
+        req_handlers[req]( &current->req, &reply );
+
+        if (current && current->reply_fd)
+        {
+            reply.reply_header.error = current->error;
+            reply.reply_header.reply_size = current->reply_size;
+            if (debug_level) trace_reply( req, &reply );
+            if (current->reply_size) memcpy( info->reply_data, current->reply_data, current->reply_size );
+            free( current->reply_data );
+            current->reply_data = NULL;
+            info->u.reply = reply;
+            ret = 0;
+        }
+        else
+        {
+            if (current)
+            {
+                current->exit_code = 1;
+                kill_thread( current, 1 );  /* no way to continue without reply fd */
+            }
+            ret = 2;
+        }
+        current = NULL;
+        thread->req_data = NULL;
+        ps5_mutex_server_end();
+    }
+    release_object( thread );
+    ps5_mutex_server_reconcile();
+    pthread_mutex_unlock( &inprocess_server_mutex );
+    return ret;
+}
