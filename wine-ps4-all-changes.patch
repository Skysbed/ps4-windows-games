@@ -0,0 +1,30 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef PW_TITLE_MENU_H
+#define PW_TITLE_MENU_H
+#include <stdint.h>
+
+/* The title's in-game menu as a game-side renderer draws it. The title owns
+ * the menu: it reads the DualSense, keeps the cursor and the text, and
+ * stores a snapshot in the sink (pw_wine_set_menu). Code inside the game
+ * (DXVK's HUD) asks for the snapshot once a frame with
+ * NtQueryInformationProcess(NtCurrentProcess(), PW_TITLE_MENU_PROCESS_INFO)
+ * and draws it over the game's image. A Wine without the class fails the
+ * query, and the renderer then has nothing to draw.
+ *
+ * Pointer-free wire layout, identical for PE32, PE64 and the Unix provider.
+ * Text is ASCII (the HUD font has no other glyphs), NUL-terminated. */
+enum { PW_TITLE_MENU_LINES=16,PW_TITLE_MENU_COLUMNS=48 };
+struct pw_title_menu
+{
+    uint32_t version;       /* PW_TITLE_MENU_VERSION */
+    uint32_t sequence;      /* the sink's: changes whenever the snapshot does */
+    uint32_t open;          /* 0: draw nothing; the rest is then zero */
+    uint32_t lines;         /* lines in use, at most PW_TITLE_MENU_LINES */
+    int32_t selected;       /* the highlighted line, or -1 */
+    char title[PW_TITLE_MENU_COLUMNS];
+    char line[PW_TITLE_MENU_LINES][PW_TITLE_MENU_COLUMNS];
+};
+#define PW_TITLE_MENU_PROCESS_INFO 0x50574D01u
+#define PW_TITLE_MENU_VERSION 1u
+
+#endif
diff --git a/dlls/ntdll/time.c b/dlls/ntdll/time.c
index 5a96a1e..ce0ad6d 100644
--- a/dlls/ntdll/time.c
+++ b/dlls/ntdll/time.c
@@ -37,6 +37,7 @@
 #include "wine/exception.h"
 #include "wine/debug.h"
 #include "ntdll_misc.h"
+#include "pw_qpc_clock.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(ntdll);
 
@@ -381,7 +382,62 @@ LONGLONG WINAPI RtlGetSystemTimePrecise( void )
  */
 BOOL WINAPI DECLSPEC_HOTPATCH RtlQueryPerformanceCounter( LARGE_INTEGER *counter )
 {
+#if defined(__i386__) || defined(__x86_64__)
+    static struct pw_qpc_anchor anchor;
+    static LONG gate, disabled, activated;
+    static DECLSPEC_ALIGN(8) LONGLONG last;
+    uint64_t value;
+    unsigned lo, hi;
+    LONGLONG previous, result;
+    if (ReadAcquire( &disabled ) && !ReadAcquire( &activated ))
+    {
+        NtQueryPerformanceCounter( counter, NULL );
+        return TRUE;
+    }
+    if (!ReadAcquire( &disabled ) && !InterlockedCompareExchange( &gate, 1, 0 ))
+    {
+        int have = 0;
+        if (anchor.validated)
+        {
+            __asm__ volatile( "lfence; rdtsc" : "=a"(lo), "=d"(hi) :: "memory" );
+            have = pw_qpc_read_anchor( &anchor, ((uint64_t)hi << 32) | lo, &value );
+        }
+        if (!have)
+        {
+            struct pw_qpc_anchor fresh;
+            if (NtQueryInformationProcess( NtCurrentProcess(), (PROCESSINFOCLASS)PW_QPC_PROCESS_INFO, &fresh, sizeof(fresh), NULL ) ||
+                !pw_qpc_read_anchor( &fresh, fresh.tsc, &value ))
+                InterlockedExchange( &disabled, 1 );
+            else
+            {
+                anchor = fresh;
+                __asm__ volatile( "lfence; rdtsc" : "=a"(lo), "=d"(hi) :: "memory" );
+                have = pw_qpc_read_anchor( &anchor, ((uint64_t)hi << 32) | lo, &value );
+            }
+        }
+        if (have)
+        {
+            counter->QuadPart = value;
+            InterlockedExchange( &activated, 1 );
+        }
+        else NtQueryPerformanceCounter( counter, NULL );
+        InterlockedExchange( &gate, 0 );
+    }
+    else NtQueryPerformanceCounter( counter, NULL );
+    /* Reanchoring uncertainty must not cause a caller's clock to go backward.
+     * The slow and fast paths participate in the same monotonic maximum. */
+    previous = InterlockedCompareExchange64( &last, 0, 0 );
+    do
+    {
+        result = counter->QuadPart > previous ? counter->QuadPart : previous;
+        value = InterlockedCompareExchange64( &last, result, previous );
+        if ((LONGLONG)value == previous) break;
+        previous = value;
+    } while (1);
+    counter->QuadPart = result;
+#else
     NtQueryPerformanceCounter( counter, NULL );
+#endif
     return TRUE;
 }
 
