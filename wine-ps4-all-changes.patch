+static struct { uint64_t memory; uintptr_t begin,end; } mappings[PW_VK_MAPPINGS];
+static unsigned allocation_count,mapping_count;
+static void *heap_alloc(size_t n){return HeapAlloc(GetProcessHeap(),0,n);}
