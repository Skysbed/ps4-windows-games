+#ifndef __WINE_PS4_LIMITS_H
+#define __WINE_PS4_LIMITS_H
+/* musl's RLIMIT numbers are Linux's. Raising "RLIMIT_NOFILE" (7) raised the kernel's RLIMIT_NPROC and left open
+ * files at the PS4's default. Numbers from WinePS4 (LGPL-2.1-or-later). Include after the system headers. */
+#ifdef __ORBIS__
+#include <sys/resource.h>
+#undef RLIMIT_MEMLOCK
+#undef RLIMIT_NPROC
+#undef RLIMIT_NOFILE
+#undef RLIMIT_AS
+#define RLIMIT_MEMLOCK 6
+#define RLIMIT_NPROC   7
+#define RLIMIT_NOFILE  8
+#define RLIMIT_AS      10
+#endif
+#endif
diff --git a/include/wine/ps4_net_abi.h b/include/wine/ps4_net_abi.h
new file mode 100644
index 0000000..9da8915
--- /dev/null
