+    while (*p)
+    {
+        if (*p == '/')
+        {
+            while (p[1] == '/') p++;                                   /* "//"  */
+            if (p[1] == '.' && (p[2] == '/' || !p[2])) { p += 2; continue; }  /* "/." */
+            if (!p[1]) break;                                          /* trailing "/" */
+        }
