+
+#ifdef WINE_INPROCESS_SERVER
+/* All metadata/list/callback operations are under the server lock. The word
+ * remains allocated and SLOW after retirement, so cached native pointers can
+ * never address freed storage or a different synchronization object. */
+static struct list ps5_sync_active = LIST_INIT(ps5_sync_active);
+static struct list ps5_sync_pending = LIST_INIT(ps5_sync_pending);
+static unsigned int ps5_sync_operation_depth;
+/* Lifetime budget counts successful allocations, including retired cells.
+ * Retired pointers can remain cached, so storage is never freed or reused.
+ * Requested payload is bounded; allocator metadata is not part of this cap. */
+#define PW_SYNC_RETAINED_PAYLOAD_BYTES (1024u * 1024u)
+#define PW_SYNC_RETAINED_CELL_LIMIT (PW_SYNC_RETAINED_PAYLOAD_BYTES / sizeof(struct ps5_sync_cell))
+static unsigned int ps5_sync_retained_cells;
+
+static void ps5_sync_queue_publish(struct ps5_sync_cell *cell)
+{
+    if (cell->pending) return;
+    list_add_tail(&ps5_sync_pending, &cell->pending_entry);
+    cell->pending = 1;
+}
+
+void ps5_sync_enter_slow(struct ps5_sync_cell *cell)
+{
+    unsigned int snapshot;
+    if (!cell) return;
+    assert(cell->sync && *cell->binding == cell);
+    ps5_sync_queue_publish(cell);
+    if (pw_sync_word_freeze(&cell->word, &snapshot))
+        cell->adopt_value(cell->sync, snapshot);
+}
+
+struct ps5_sync_cell *ps5_sync_prepare(struct object *sync, struct ps5_sync_cell **binding, int *disabled,
+    unsigned int kind, unsigned int maximum, unsigned int (*read_value)(struct object *),
+    void (*adopt_value)(struct object *, unsigned int))
+{
+    struct ps5_sync_cell *cell;
+    void *storage;
+    if (*disabled) return NULL;
+    if ((cell = *binding)) return cell;
+    if (ps5_sync_retained_cells >= PW_SYNC_RETAINED_CELL_LIMIT)
+    {
+        *disabled = 1; /* Permanent ordinary fallback; do not retry a full budget. */
+        return NULL;
+    }
+    if (posix_memalign(&storage, 64, sizeof(*cell))) return NULL;
+    ++ps5_sync_retained_cells;
+    cell = storage;
+    memset(cell, 0, sizeof(*cell));
+    pw_sync_word_init(&cell->word, kind, read_value(sync), maximum);
+    cell->sync = grab_object(sync);
+    cell->binding = binding;
+    cell->disabled = disabled;
+    cell->read_value = read_value;
+    cell->adopt_value = adopt_value;
+    *binding = cell;
+    list_add_tail(&ps5_sync_active, &cell->active_entry);
+    ps5_sync_queue_publish(cell);
+    return cell;
+}
+
+void ps5_sync_server_begin(void)
+{
+    ++ps5_sync_operation_depth;
+}
+
+void ps5_sync_server_reconcile(void)
+{
+    struct ps5_sync_cell *cell;
+    struct list *entry;
+    if (ps5_sync_operation_depth) return;
+    while ((entry = list_head(&ps5_sync_pending)))
+    {
+        cell = LIST_ENTRY(entry, struct ps5_sync_cell, pending_entry);
+        list_remove(entry);
+        cell->pending = 0;
+        assert(cell->sync && *cell->binding == cell);
+        if (!__atomic_load_n(&inprocess_direct_ok, __ATOMIC_ACQUIRE) || debug_level ||
+            !list_empty(&cell->sync->wait_queue)) continue;
+        pw_sync_word_publish(&cell->word, cell->read_value(cell->sync));
+    }
+}
+
+void ps5_sync_server_end(void)
+{
+    assert(ps5_sync_operation_depth);
+    if (!--ps5_sync_operation_depth) ps5_sync_server_reconcile();
+}
+
+void ps5_sync_retire(struct ps5_sync_cell **binding)
+{
+    struct ps5_sync_cell *cell = *binding;
+    struct object *sync;
+    if (!cell) return;
+    ps5_sync_enter_slow(cell);
+    if (cell->pending) list_remove(&cell->pending_entry);
+    cell->pending = 0;
+    list_remove(&cell->active_entry);
+    sync = cell->sync;
+    *cell->disabled = 1;
+    *binding = NULL;
+    cell->sync = NULL;
+    cell->binding = NULL;
+    cell->disabled = NULL;
+    /* Do not free cell or clear SLOW. Its retained word has no live pointer
+     * into the sync; the activation reference can now be dropped safely. */
+    release_object(sync);
+}
+
+void ps5_sync_server_disable(void)
+{
+    struct list *entry;
+    while ((entry = list_head(&ps5_sync_active)))
+        ps5_sync_retire(LIST_ENTRY(entry, struct ps5_sync_cell, active_entry)->binding);
+}
