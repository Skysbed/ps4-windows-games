+   *bytes+=used;(*records)++;next_replay++;found=TRUE;break;
+  }
+  if(!found){wait_tick("collect",list,n,marker,&spins,&start,&reported);SwitchToThread();}
+  else {spins=0;start=0;reported=FALSE;}
