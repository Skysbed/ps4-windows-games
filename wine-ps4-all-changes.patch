+        free( dir );
+        if (!env) env = "/app0/sce_module"; /* PS4: env not shared across modules */
+        dir = strdup( env );
+    }
+    if (build_dir)
+    {
+        if (asprintf( &module_path, "%s/server/wineserver.so", build_dir ) == -1) module_path = NULL;
+        if (asprintf( &nls_dir, "%s/nls", build_dir ) == -1) nls_dir = NULL;
+    }
+    else
+    {
+        if (asprintf( &module_path, "%s/wineserver.so", dir ) == -1) module_path = NULL;
+        if (asprintf( &nls_dir, "%s/nls", data_dir ? data_dir : dir ) == -1) nls_dir = NULL;
+    }
+    if (!module_path || !nls_dir) fatal_error( "out of memory\n" );
